{
  "cli": {
    "version": ">= 3.8.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "production"
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "apk"
    },
    "qa-manifest": {
      "distribution": "internal",
      "channel": "qa-manifest-local-only",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_QA_SERVER_FIELD": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
