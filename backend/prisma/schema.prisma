// Skema database untuk Klinik Matras Omnichannel + CRM
// Dirancang supaya tidak perlu migrasi besar saat Phase 2 (Instagram) & Phase 3 (CRM lanjutan)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role lama (ADMIN/SALES) TETAP dipakai lewat User.role sampai middleware
// otorisasi Sano Hub terbukti. Role operasional baru hanya dipegang lewat
// tabel UserRole — lihat docs/sano-hub/DECISIONS.md (D-010).
enum Role {
  ADMIN
  SALES
  PRODUCTION_LEAD
  PRODUCTION_WORKER
  QC_LEAD
  WAREHOUSE
  DISPATCHER
  DRIVER
  FINANCE
}

// Lini produk penentu katalog material, termin garansi, dan lead time (D-004).
// SERVICE = restorasi, material grade standar.
// UPGRADE = dibangun ke standar Matras Sehat, material premium.
// Satu unit TIDAK BOLEH mencampur modul lintas lini.
enum ServiceLine {
  SERVICE
  UPGRADE
}

// Fase menentukan urutan besar: INTAKE selalu dulu, MODULE di tengah (0..n,
// dipilih per unit), FINISH selalu terakhir. `sequence` mengurutkan DI DALAM
// fase, bukan lintas fase.
enum StagePhase {
  INTAKE
  MODULE
  FINISH
}

// Status KASAR unit. Posisi halus di dalam produksi dilacak routing stage +
// unit_stage_logs, BUKAN enum ini — jangan menambah nilai per-tahap ke sini.
enum UnitStatus {
  AWAITING_PICKUP
  IN_TRANSIT_IN
  RECEIVED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  READY_ON_CUSTOMER_HOLD // sudah jadi, customer minta tunda kirim — jam terpisah, BUKAN telat kita (D-007)
  IN_TRANSIT_OUT
  DELIVERED
  CANCELLED
}

enum Channel {
  WHATSAPP
  INSTAGRAM
}

// Sumber marketing pelanggan (beda dengan Channel -- itu medium chat-nya)
enum LeadSource {
  META_ADS // iklan Instagram/Facebook — menggantikan ADS
  GOOGLE_ADS // iklan Google
  WEBSITE_ORGANIC // klik organik dari website — menggantikan WEBSITE
  INSTAGRAM // DM organik Instagram (bukan iklan)
  WHATSAPP_DIRECT // chat organik langsung ke WA
  REFERRAL
  OTHER
  // Deprecated — jangan digunakan di kode baru, dijaga untuk kompatibilitas data lama
  ADS
  WEBSITE
}

// Kategori tracked link untuk atribusi
enum LinkCategory {
  META_ADS
  GOOGLE_ADS
  WEBSITE_ORGANIC
  OTHER
}

enum OrderStatus {
  PENDING // baru order, belum diproses
  PICKUP // sedang diambil dari lokasi customer
  PROCESSING // sedang dikerjakan/produksi
  READY // siap kirim
  DELIVERED // sudah terkirim/selesai
  CANCELLED
}

enum PaymentStatus {
  BELUM_BAYAR // belum ada pembayaran
  DP // sudah bayar uang muka
  LUNAS // sudah lunas
}

enum OrderCategory {
  LAYANAN // Upgrade/Service/Ganti Kain
  SEWA // Kasur Sewa
  BARU // Kasur Baru
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum ConversationType {
  INDIVIDUAL // percakapan 1-on-1 dengan customer
  GROUP // percakapan grup WhatsApp internal (tidak ada customer)
}

// Revisi 26 Jul 2026: dari 5 stage (LEAD/QUALIFIED/QUOTED/WON/LOST) jadi 8
// stage yang mengikuti exit-criteria eksplisit tiap tahap operasional nyata
// (bukan lagi cuma "menang/kalah"). LOST DIHAPUS (keputusan bisnis) — data
// customer yang dulu LOST dipetakan ke QUALIFIED lewat migrasi data, WON lama
// dipetakan ke PAID. "Berhasil"/closing yang SEBENARNYA sekarang PAID (bukan
// BOOKED) — pembayaran diterima, bukan sekadar deal disepakati. Lihat
// migration 20260726120000_migrate_pipeline_stage_8_wave untuk detail mapping.
// Revisi 30 Jul 2026: PAID dihapus dari pipeline (7 stage, dari 8). Tracking
// pembayaran sudah punya rumah sendiri yang lebih tepat: Order.paymentStatus
// (BELUM_BAYAR/DP/LUNAS), per-ORDER bukan per-pelanggan — pelanggan dengan
// beberapa order bisa saja 1 lunas 1 belum, sesuatu yang tidak pernah bisa
// direpresentasikan oleh 1 stage pipeline tunggal. Sempat ada percobaan
// sinkron otomatis (pipeline "Paid" -> semua order jadi LUNAS) tapi ini
// cuma tambal masalah yang akar sebabnya stage ini sendiri redundan —
// dihapus total, bukan disinkronkan terus-menerus. Lihat migrasi
// 20260730_remove_paid_pipeline_stage untuk mapping data lama (PAID -> COMPLETED).
enum PipelineStage {
  NEW // Lead baru masuk WhatsApp, belum kirim data diri
  QUALIFIED // Data minimum lengkap (kota, ukuran, foto, keluhan) + area layanan cocok + ada intent
  QUOTED // Sudah dikasih harga/rekomendasi
  BOOKED // Setuju harga+jadwal, penuhi syarat booking
  SCHEDULED // Sudah dijadwalkan pickup/kunjungan teknisi
  COMPLETED // Pekerjaan selesai dikerjakan — SEKARANG stage terakhir "operasional", dianggap "berhasil" (dulu diwakili PAID)
  REVIEWED // Sudah kasih review Google Maps / testimoni WhatsApp
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CustomerType {
  END_USER
  CORPORATE
}

enum HealthStatus {
  SAKIT
  TIDAK_SAKIT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES)
  avatarUrl    String? // foto profil, path relatif "/uploads/avatars/xxx.jpg"
  createdAt    DateTime @default(now())

  // Nonaktifkan (mis. sales resign) TANPA menghapus baris User — riwayat
  // (percakapan yang pernah dia tangani, order yang teratribusi, dst) HARUS
  // tetap utuh untuk laporan periode lama (lihat CLAUDE.md soal RESTRICT di
  // Unit/Order — prinsip yang sama: jangan hilangkan jejak data demi
  // "membersihkan" tampilan). User nonaktif: tidak bisa login (auth.js),
  // tidak muncul lagi di picker assign/transfer atau baris per-sales di
  // Laporan (routes/users.js GET / default exclude, routes/analytics.js),
  // TAPI order/transaksi historisnya tetap dihitung penuh di angka
  // company-wide (Dashboard/Ringkasan) karena endpoint itu agregat dari
  // Order/Customer langsung, tidak difilter per-user.
  active       Boolean  @default(true)

  assignedCustomers         Customer[]               @relation("AssignedSales")
  assignedConversations     Conversation[]           @relation("AssignedAgent")
  notes                     Note[]
  salesTargets              SalesTarget[]
  pushTokens                PushToken[]
  sentMessages              Message[]                @relation("MessageSender")
  firstResponderFor         Conversation[]           @relation("FirstResponder")
  handoverEventsFrom        HandoverEvent[]          @relation("HandoverFrom")
  handoverEventsTo          HandoverEvent[]          @relation("HandoverTo")
  pipelineTransitions       PipelineTransition[]     @relation("PipelineTransitionActor")
  orderStatusChanges        OrderStatusTransition[]  @relation("OrderStatusActor")
  orderStatusOverrides      Order[]                  @relation("OrderStatusOverrider")
  messageTemplates          MessageTemplate[]
  unitStageLogs             UnitStageLog[]           @relation("UnitStageLogActor")
  jobsAsDriver              Job[]                    @relation("JobDriver")
  qcFitTests                QcFitTest[]              @relation("QcFitTestTester")
  productionTargets         ProductionTarget[]       @relation("ProductionTargetCreator")
  paymentsRecorded          Payment[]                @relation("PaymentRecorder")
  paymentsVerified          PaymentVerification[]    @relation("PaymentVerifier")
  stockMovements            StockMovement[]          @relation("StockMovementActor")
  routesAsDriver            Route[]                  @relation("RouteDriver")
  podVerified               Job[]                    @relation("PodVerifier")
  jobsRescheduled           Job[]                    @relation("JobRescheduler")
  unitRevisionsCreated      UnitRevision[]           @relation("UnitRevisionCreator")
  goodsReceiptsCreated      GoodsReceipt[]           @relation("GoodsReceiptCreator")
  materialIssuesRequested   MaterialIssue[]          @relation("MaterialIssueRequester")
  materialIssuesApproved    MaterialIssue[]          @relation("MaterialIssueApprover")
  materialIssuesIssued      MaterialIssue[]          @relation("MaterialIssueIssuer")
  materialIssuesCreated     MaterialIssue[]          @relation("MaterialIssueCreator")
  stockTransfersRequested   StockTransfer[]          @relation("StockTransferRequester")
  stockTransfersApproved    StockTransfer[]          @relation("StockTransferApprover")
  stockCountsAssigned       StockCount[]             @relation("StockCountAssignee")
  stockCountsReviewed       StockCount[]             @relation("StockCountReviewer")
  stockCountsCreated        StockCount[]             @relation("StockCountCreator")
  damagedStockReported      DamagedStockRecord[]     @relation("DamagedStockReporter")
  damagedStockResolved      DamagedStockRecord[]     @relation("DamagedStockResolver")
  returnRecordsCreated      ReturnRecord[]           @relation("ReturnRecordCreator")
  stockAdjustmentsRequested StockAdjustmentRequest[] @relation("StockAdjustmentRequester")
  stockAdjustmentsApproved  StockAdjustmentRequest[] @relation("StockAdjustmentApprover")
  stockAdjustmentsPosted    StockAdjustmentRequest[] @relation("StockAdjustmentPoster")
  replenishmentsRequested   ReplenishmentRequest[]   @relation("ReplenishmentRequester")
  replenishmentsApproved    ReplenishmentRequest[]   @relation("ReplenishmentApprover")
  routesCreated             Route[]                  @relation("RouteCreator")
  scopeRevisionsMade        ScopeRevision[]          @relation("ScopeRevisionProposer")
  scopeRevisionsDecided     ScopeRevision[]          @relation("ScopeRevisionDecider")
  productsCreated           Product[]                @relation("ProductCreator")

  roles        UserRole[] @relation("UserRoleHolder")
  rolesGranted UserRole[] @relation("UserRoleGrantor")
}

// Role JAMAK per user — permission bersifat ADITIF (D-010). Satu orang bisa
// sekaligus Production Lead dan QC Leader; di tim 7 orang itu normal.
//
// SENGAJA TIDAK menggantikan User.role di Phase 0. Seluruh kode yang jalan
// sekarang masih membaca User.role, dan mengubah arti kolom yang sudah dipakai
// 7 orang di jam kerja bukan langkah yang aman. Dua-duanya hidup dulu; yang
// lama dimatikan setelah middleware otorisasi baru terbukti (pola strangler,
// sama seperti migrasi design system).
//
// TIDAK ADA "super admin bisa segalanya" sebagai default — itu menghancurkan
// jejak audit yang justru jadi alasan sistem ini dibangun (PRD §3).
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")
  user   User   @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  // SetNull, bukan Cascade: kalau admin pemberi role resign, role yang sudah
  // diberikan TETAP berlaku — cuma jejak pemberinya yang hilang.
  grantedById String? @map("granted_by")
  grantedBy   User?   @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, role])
  @@index([role]) // "siapa saja driver aktif" — dipakai papan dispatch nanti
  @@map("user_roles")
}

// Revisi 26 Jul 2026: template pesan dipindah dari file JSON polos
// (backend/data/templates.json, TANPA kepemilikan — SEMUA user baca/tulis
// file yang SAMA, race condition nyata kalau 2 sales edit bersamaan karena
// tidak ada transaksi) ke tabel database dengan KEPEMILIKAN eksplisit.
//
// Skema kepemilikan (keputusan bisnis 26 Jul 2026 — "sales punya template
// masing-masing yang bisa dicustomize"):
//   - isShared=true  → "Template Tim", terlihat & terpakai SEMUA user, tapi
//     HANYA ADMIN yang boleh membuat/mengedit/menghapusnya (kontinuitas
//     nada komunikasi perusahaan — 5 template lama dari templates.json
//     dimigrasikan ke sini sebagai isShared=true, authorId=null).
//   - isShared=false → "Template Saya", pribadi milik authorId, HANYA
//     pemiliknya (atau ADMIN) yang boleh mengedit/menghapus. SALES yang
//     membuat template BARU selalu isShared=false (dipaksa di route,
//     bukan cuma di UI) — mencegah tiap sales menambah ke daftar bersama
//     tim tanpa kurasi.
// authorId NULLABLE + SetNull (bukan Cascade): template company (isShared)
// authorId-nya memang null; kalau user personal dihapus, template
// pribadinya TETAP ADA (jadi "tanpa pemilik", bukan ikut terhapus — supaya
// isi yang sudah teruji tidak hilang begitu saja saat sales resign).
model MessageTemplate {
  id        String   @id @default(cuid())
  nama      String
  kategori  String   @default("lainnya")
  isi       String
  isShared  Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([isShared])
}

// Token push notification aplikasi mobile (Expo Push Token) — 1 user bisa
// punya beberapa device. Token dihapus otomatis kalau Expo bilang invalid.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // format: ExponentPushToken[xxxx]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id                      String        @id @default(cuid())
  name                    String?
  phone                   String?       @unique // format: 628xxxx (tanpa @c.us)
  instagramHandle         String?       @unique
  email                   String?
  city                    String?
  tags                    String[]      @default([])
  pipelineStage           PipelineStage @default(NEW)
  leadSource              LeadSource?
  assignedSalesId         String?
  assignedSales           User?         @relation("AssignedSales", fields: [assignedSalesId], references: [id])
  leadSourceDetail        String? // detail tambahan: nama link/campaign/ad headline
  leadSourceConfirmed     Boolean       @default(false) // true = dikoreksi manual oleh sales

  // ── Atribusi iklan Meta Click-to-WhatsApp (CTWA) ──────────────────────
  // Iklan CTWA melompat LANGSUNG ke WhatsApp tanpa lewat website, jadi tag
  // tak-terlihat dari sanomatrassehat.com tidak pernah kepasang. Satu-satunya
  // jejak adalah contextInfo di payload WAHA (engine GOWS mengirimnya —
  // lihat services/leadAttribution.js extractCtwaContext).
  //
  // ctwaClid = Click ID dari Meta, unik per klik iklan. Disimpan di KOLOM
  // SENDIRI (bukan cuma diselipkan ke leadSourceDetail) supaya bisa
  // di-query untuk kirim balik data konversi ke Meta Conversions API nanti
  // — itu yang membuat Meta bisa mengoptimalkan iklan ke orang yang
  // BENAR-BENAR closing, bukan sekadar yang chat.
  ctwaClid                String?       @map("ctwa_clid")
  // URL postingan/kreatif yang dipakai iklannya (mis. link post Instagram).
  // Berguna untuk tahu kreatif MANA yang menghasilkan lead, karena payload
  // WA tidak membawa nama campaign.
  ctwaSourceUrl           String?       @map("ctwa_source_url")
  customerType            CustomerType  @default(END_USER)
  healthStatus            HealthStatus?
  profilePictureUrl       String? // foto profil WA, nullable — di-refresh berkala (lihat profilePictureFetchedAt)
  profilePictureFetchedAt DateTime? // kapan terakhir dicoba fetch dari WAHA — dipakai cek "expired >7 hari" di webhooks.js, JUGA distempel saat fetch GAGAL (privasi dibatasi dsb) supaya tidak coba lagi tiap pesan masuk sampai TTL lewat
  nameManuallyEdited      Boolean       @default(false) // true = sales sudah edit nama manual di CRM (PATCH /customers/:id) — webhook TIDAK BOLEH timpa lagi dengan pushName/contact WAHA
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Revisi 27 Jul 2026: DENORMALIZED dari tabel Order (bukan sumber
  // kebenaran — sumber kebenaran tetap Order.value/status), disinkronkan
  // lewat services/customerOrderAggregate.js SETIAP kali order berubah
  // (buat/hapus/ubah status atau value, tambah/ubah/hapus item layanan).
  // CANCELLED dikecualikan dari keduanya — konsisten dengan definisi yang
  // sudah dipakai di analytics/sales-report/GET pipeline board.
  //
  // KENAPA didenormalisasi (bukan dihitung on-the-fly tiap request seperti
  // sebelumnya): tabel Pelanggan (1.320+ baris & terus bertambah) butuh
  // filter ("Belum Order"), sort ("Nilai Order" terbesar), DAN paginasi di
  // level DATABASE secara bersamaan. Prisma tidak bisa mem-filter/mengurutkan
  // findMany berdasarkan SUM relasi yang difilter (WHERE status != CANCELLED)
  // tanpa raw SQL — kolom asli di sini membuat WHERE/ORDER BY/LIMIT jadi query
  // Postgres biasa, bukan agregasi ulang tiap kali halaman dibuka.
  orderCount Int @default(0)
  orderValue Int @default(0)

  conversations Conversation[]
  notes         Note[]
  orders        Order[]

  pipelineTransitions PipelineTransition[]

  @@index([createdAt]) // widget "Distribusi Lead per Sesi" & drill-down leads-detail — filter by createdAt tiap hari/minggu/bulan
  @@index([orderValue]) // sort "Nilai Order" & filter VIP (>=Rp5jt) di tabel Pelanggan
  @@index([orderCount]) // filter cepat "Belum Order" (orderCount = 0)
}

// Log SETIAP perpindahan pipeline stage seorang customer (NEW → QUALIFIED →
// ...). Customer.pipelineStage hanya menyimpan posisi SEKARANG — tabel ini
// menyimpan RIWAYAT-nya, supaya laporan bisa bergeser dari sekadar "berapa
// banyak di stage X sekarang" ke data time-series: kecepatan pipeline (berapa
// lama rata-rata NEW→COMPLETED), analisa cohort, dan tren konversi per periode.
//
// APPEND-ONLY: baris di sini tidak pernah di-update/dihapus (kecuali ikut
// terhapus bersama customer-nya). Ditulis dalam transaksi yang sama dengan
// update Customer.pipelineStage — lihat routes/customers.js PATCH /:id.
//
// PENAMAAN FISIK: tabel & kolom sengaja snake_case (`pipeline_transitions`,
// `customer_id`, ...) via @@map/@map sesuai permintaan, sementara nama field
// di Prisma tetap camelCase mengikuti gaya model lain di file ini.
model PipelineTransition {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromStage  PipelineStage @map("from_stage")
  toStage    PipelineStage @map("to_stage")

  // Siapa yang memindahkan. Nullable + SetNull: kalau user dihapus, riwayat
  // pipeline TETAP ada (data laporan historis tidak boleh hilang karena
  // pegawai resign).
  changedById String? @map("changed_by")
  changedBy   User?   @relation("PipelineTransitionActor", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") // UTC — lihat src/utils/wib.js

  @@index([customerId, createdAt]) // timeline per customer
  @@index([createdAt]) // agregasi time-series lintas customer (tren harian/bulanan)
  @@index([toStage, createdAt]) // "berapa yang masuk COMPLETED per periode" — velocity & funnel
  @@map("pipeline_transitions")
}

model Conversation {
  id            String             @id @default(cuid())
  type          ConversationType   @default(INDIVIDUAL) // INDIVIDUAL = customer, GROUP = grup WA internal
  customerId    String? // nullable — GROUP tidak punya customer
  customer      Customer?          @relation(fields: [customerId], references: [id])
  groupJid      String? // JID grup e.g. "120363376@g.us" (hanya untuk type=GROUP)
  groupName     String? // nama grup (hanya untuk type=GROUP)
  channel       Channel
  status        ConversationStatus @default(OPEN)
  assignedToId  String?
  assignedTo    User?              @relation("AssignedAgent", fields: [assignedToId], references: [id])
  lastMessageAt DateTime           @default(now())
  unread        Boolean            @default(false) // RENCANA: dihapus setelah unreadCount stabil, lihat CLAUDE.md
  isRead        Boolean            @default(false) // sudah dibuka (di CRM atau di HP)
  readAt        DateTime? // kapan terakhir dibaca
  handoverNote  String?
  pinned        Boolean            @default(false) // disematkan di atas daftar
  pinnedAt      DateTime? // kapan terakhir disematkan
  createdAt     DateTime           @default(now())

  // Grup WhatsApp yang ditugaskan menerima dokumentasi pickup/delivery
  // driver (D-018). Hanya bermakna untuk type=GROUP. Partial unique index
  // di database memastikan CUMA SATU conversation boleh true sekaligus —
  // ditandai admin SEKALI, bukan dipilih ulang tiap job selesai.
  isDriverGroup Boolean @default(false)

  // Sales yang PERTAMA KALI kirim balasan outbound dari CRM di percakapan
  // ini — diisi SEKALI (tidak pernah berubah lagi walau assignedToId
  // berpindah-pindah lewat takeover/transfer), lihat routes/conversations.js
  // #POST /:id/messages & #POST /:id/media. Beda dari assignedToId (sales
  // yang SEDANG menangani sekarang) — badge "first responder" di daftar
  // Inbox pakai field ini, BUKAN assignedToId, supaya tetap kelihatan siapa
  // yang pertama merespons meski sudah di-takeover berkali-kali.
  firstResponderId String?
  firstResponder   User?   @relation("FirstResponder", fields: [firstResponderId], references: [id])

  handoverEvents HandoverEvent[]

  sessionId          String? // nama session WAHA pengirim, "CS-1"/"CS-2" (multi-nomor)
  lastMessagePreview String? // denormalized: potongan teks pesan terakhir, untuk list tanpa join Message
  unreadCount        Int     @default(0) // pengganti `unread` (boolean) — jumlah pesan INBOUND belum dibuka

  messages Message[]

  // CATATAN RACE CONDITION FIX: 2 event webhook (message + message.any)
  // bisa tiba <1ms terpisah dan sama-sama gagal menemukan Conversation aktif
  // yang sama sebelum salah satunya selesai INSERT — hasilnya 2 Conversation
  // dobel untuk 1 customer. Perlindungan SEBENARNYA adalah PARTIAL UNIQUE
  // INDEX di level database (bukan `@@unique` polos — customer yang
  // percakapannya di-"Tandai Selesai"/RESOLVED harus tetap bisa dapat
  // Conversation BARU saat chat lagi nanti, alur ini sudah lama dipakai di
  // 3 tempat di webhooks.js):
  //   CREATE UNIQUE INDEX ... ON "Conversation" ("customerId", "channel")
  //     WHERE status != 'RESOLVED'
  //   CREATE UNIQUE INDEX ... ON "Conversation" ("groupJid")
  //     WHERE status != 'RESOLVED'
  // Prisma schema DSL TIDAK bisa menyatakan WHERE pada @@unique, jadi index
  // ini HANYA ada di file migration.sql (raw SQL), TIDAK dideklarasikan
  // sebagai @@unique di sini — kalau dideklarasikan di sini, `prisma
  // migrate dev` berikutnya akan coba "perbaiki drift" dengan menghapus
  // partial index dan menggantinya index unique polos yang salah.
  // @@index biasa di bawah ini cuma untuk performa query, BUKAN proteksi.
  @@index([channel, status])
  @@index([customerId, channel])
  @@index([pinned])
  @@index([groupJid])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([assignedToId, status])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  content        String           @default("") // teks / caption (bisa kosong untuk media)
  mediaType      String? // "image" | "video" | "audio" | "document"
  mediaUrl       String? // path lokal: /uploads/xxx atau URL WAHA
  externalId     String?          @unique
  replyToId      String? // ID pesan yang dibalas (untuk fitur quote/reply)
  replyTo        Message?         @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies        Message[]        @relation("MessageReply")
  forwarded      Boolean          @default(false) // true = pesan diteruskan dari percakapan lain
  senderName     String? // nama pengirim (untuk pesan grup — beda-beda per pesan)
  ack            Int              @default(0) // 0 pending, 1 sent, 2 delivered, 3 read (WAHA message.ack)
  editedAt       DateTime? // diisi saat WAHA message.edited masuk — bubble tampilkan label "diedit"
  isRevoked      Boolean          @default(false) // soft-delete (WAHA message.revoked) — content dikosongkan, bubble tetap ada ("Pesan ini telah dihapus")
  createdAt      DateTime         @default(now())

  // Revisi 28 Jul 2026: tipe pesan WhatsApp ASLI dari parseHistoryMessage.js
  // (mis. "image", "location", "text", atau nama field mentah WAHA kalau
  // TIDAK dikenali sama sekali, mis. "reactionMessage"). Paling berguna untuk
  // kasus tidak dikenali (content jadi "[Pesan tidak didukung]") — SEBELUMNYA
  // info ini cuma di-console.warn lalu dibuang, jadi begitu log server
  // ke-reset (mis. redeploy) kita PERMANEN kehilangan info tipe apa yang
  // sebenarnya masuk, padahal itu pesan sungguhan yang tidak terbaca di CRM.
  rawType String?

  // Sales yang kirim pesan OUTBOUND ini dari CRM (web/app) — null untuk
  // pesan INBOUND (dari customer) dan pesan lama sebelum field ini ada.
  // Dipakai buat set Conversation.firstResponderId sekali di
  // routes/conversations.js saat pesan outbound PERTAMA di percakapan itu
  // tersimpan.
  sentById String?
  sentBy   User?   @relation("MessageSender", fields: [sentById], references: [id])

  // Revisi 28 Jul 2026 — BUG PRODUKSI SERIUS: clientId dibuat mobile/web
  // SEKALI per percobaan kirim (ChatScreen.js#handleSend), tapi SEBELUMNYA
  // cuma dipakai rekonsiliasi optimistic-UI, TIDAK PERNAH disimpan/dicek di
  // server. Di lapangan (koneksi 4G naik-turun), request kirim pesan bisa
  // TIMEOUT di HP (30 detik, lihat mobile/src/api.js) padahal sendText() ke
  // WAHA di server SUDAH BERHASIL — client menganggap gagal, memasukkan ke
  // outbox (lib/outboxFlush.js), lalu retry beberapa menit kemudian
  // mengirim ULANG pesan yang SEBENARNYA sudah terkirim. Karena server tidak
  // pernah cek "clientId ini pernah diproses belum", tiap retry = kirim
  // WhatsApp SUNGGUHAN baru — pelanggan menerima pesan yang sama berkali-
  // kali. clientId sekarang disimpan + dicek DULU sebelum sendText()
  // dipanggil lagi (lihat routes/conversations.js POST /:id/messages).
  clientId String? @unique

  @@index([conversationId])
}

// Log SETIAP kali percakapan berpindah tangan (takeover ATAU transfer manual
// admin) — beda dari Conversation.handoverNote (cuma simpan 1 catatan
// TERAKHIR, ketimpa tiap kali pindah tangan lagi). Dipakai utk tampilkan
// riwayat penanganan LENGKAP di chat window ("Riwayat Penanganan"), bukan
// cuma handover paling baru.
model HandoverEvent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUserId     String? // null = belum pernah ada yang pegang sebelumnya (klaim pertama)
  fromUser       User?        @relation("HandoverFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User         @relation("HandoverTo", fields: [toUserId], references: [id])
  reason         String? // "takeover" | "transfer" — dibedakan biar riwayat jelas siapa yang inisiasi
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Note {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    String? // "Upgrade" | "Matras Baru" | "Garansi" | "Servis" | "Info" | "Lainnya"
  price       Int?
  priceUnit   String? // "per unit" | "mulai dari" | null
  images      ProductImage[]
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)

  // Sales sekarang boleh menambah produk sendiri (sebelumnya admin-only).
  // NULL = dibuat sebelum kolom ini ada, atau admin (tidak perlu dibedakan
  // untuk admin karena admin selalu boleh edit/hapus produk apa pun).
  // Dipakai untuk membatasi sales HANYA boleh edit/hapus produk buatannya
  // sendiri — lihat requireOwnerOrAdmin di routes/products.js.
  createdById String?
  createdBy   User?          @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // "/media/products/xxx.jpg"
  label     String? // "Before" | "After" | "Detail" | null
  sortOrder Int     @default(0)
}

model TrackedLink {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  category         LinkCategory
  prefilledMessage String       @default("Halo Sano, saya mau konsultasi")
  targetPhone      String? // null = pakai WAHA_BUSINESS_NUMBER dari .env
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  clicks           ClickEvent[]
}

model ClickEvent {
  id                String      @id @default(cuid())
  trackedLinkId     String
  trackedLink       TrackedLink @relation(fields: [trackedLinkId], references: [id])
  matchedCustomerId String? // diisi setelah berhasil dicocokkan ke customer
  createdAt         DateTime    @default(now())

  @@index([createdAt])
}

model Order {
  id              String        @id @default(cuid())
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  status          OrderStatus   @default(PENDING)
  // D-006, Integrasi Fase 1 — status DIHITUNG dari status unit terkait
  // (weakest-link: unit paling tertinggal yang menentukan), bukan ditulis
  // manual lagi. Lihat services/orderStatusSync.js. Kalau statusLocked=true,
  // sync BERHENTI menyentuh status ini — dikunci oleh override manusia
  // (kasus di luar pola normal: dibatalkan, dst), sampai dilepas lagi.
  statusLocked       Boolean   @default(false) @map("status_locked")
  statusOverrideById String?   @map("status_override_by")
  statusOverrideBy   User?     @relation("OrderStatusOverrider", fields: [statusOverrideById], references: [id], onDelete: SetNull)
  statusOverrideAt   DateTime? @map("status_override_at")
  statusOverrideNote String?   @map("status_override_note")
  paymentStatus   PaymentStatus @default(BELUM_BAYAR)
  category        OrderCategory @default(LAYANAN)
  value           Int // nilai order dalam Rupiah (cache = SUM items.harga, 0 jika belum ada item)
  quantity        Int           @default(1)
  beratBadan      Int? // berat badan customer dalam kg, nullable
  orderNumber     String?       @unique // di-generate otomatis saat order dibuat
  notes           String?
  hasComplaint    Boolean       @default(false)
  complaintDate   DateTime?
  complaintDetail String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items             OrderItem[]
  weightEntries     OrderWeightEntry[]
  statusTransitions OrderStatusTransition[]
  units             Unit[]
  jobs              Job[]
  payments          Payment[]
  scopeRevisions    ScopeRevision[]

  @@index([customerId])
  @@index([status, createdAt]) // papan Order per status + laporan antrean produksi
}

// UNIT — entitas inti Sano Hub (D-002). Satu kasur fisik.
//
// Satu Order bisa berisi banyak Unit. Tiap Unit punya QR, diagnosa, racikan,
// tahap, foto, dan tanggal selesainya SENDIRI. Order cuma pembungkus
// komersial. Pesanan hotel 30 kasur dikirim bertahap dan tidak pernah berada
// di satu status — karena itu Order.status akhirnya jadi TURUNAN dari unit,
// bukan sumber kebenaran (D-006).
//
// UPDATE (Integrasi Fase 1): peralihan ke status turunan SUDAH terjadi —
// lihat statusLocked dkk di atas dan services/orderStatusSync.js.
//
// BELUM ADA DI SINI, sengaja (jangan tambahkan sebelum fase-nya tiba):
//   - current_stage_id  → menyusul bersama migrasi routing_stages
//   - service_code      → menyusul bersama migrasi service_catalog
//   - foto, QR, lokasi rak detail, diagnosa → Phase 1
model Unit {
  id       String @id @default(uuid()) @db.Uuid
  // Kode QR terbaca manusia: "<orderNumber>-U<n>", mis. RES-07072026-001-U2.
  // Order lama tanpa orderNumber (hasil import Excel Jan–Jun) memakai fallback
  // "LEG-<8 char id order>" — jujur menandai baris warisan.
  unitCode String @unique @map("unit_code")

  // RESTRICT, bukan Cascade: menghapus Order yang kasurnya masih dipegang
  // bengkel harus GAGAL KERAS, bukan menghapus jejak unit diam-diam.
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  seq Int // nomor urut unit di dalam order-nya, mulai 1

  // Deskripsi fisik PER UNIT — inilah inti D-002. Satu order bisa berisi satu
  // queen dan satu king. Hari ini merk/ukuran cuma ada SATU per order, dan
  // tersimpan sebagai string JSON di dalam Order.notes (lihat buildNotes /
  // parseNotes di frontend + mobile) — bukan kolom asli.
  merk   String?
  ukuran String?

  // Ditetapkan di tahap Uji Fondasi setelah kasur dibongkar, BUKAN saat sales
  // input order (D-008). NULL sampai unit benar-benar diperiksa.
  serviceLine ServiceLine? @map("service_line")

  status          UnitStatus @default(AWAITING_PICKUP)
  storageLocation String?    @map("storage_location")

  // Layanan yang berlaku untuk unit ini. Ditetapkan/direvisi di Uji Fondasi,
  // bukan saat sales input order. Menentukan modul kerja mana yang dilalui.
  serviceId String?         @map("service_id") @db.Uuid
  service   ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Posisi unit sekarang di dalam routing. NULL = belum masuk produksi.
  currentStageId String?       @map("current_stage_id") @db.Uuid
  currentStage   RoutingStage? @relation(fields: [currentStageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stageLogs         UnitStageLog[]
  jobUnits          JobUnit[]
  qcFitTests        QcFitTest[]
  productionTargets ProductionTarget[]
  stockMovements    StockMovement[]
  scopeRevisions    ScopeRevision[]
  revisions         UnitRevision[]

  @@unique([orderId, seq])
  @@index([orderId])
  @@index([status]) // papan bengkel & Kendali: "berapa unit per status"
  @@index([currentStageId]) // papan Kanban per tahap
  @@map("units")
}

// TAHAP PRODUKSI SEBAGAI DATA (D-003).
//
// Isi tabel ini adalah sumber kebenaran urutan produksi — lihat
// docs/sano-hub/ROUTING.md. Enam layanan TIDAK punya enam template; ada satu
// tulang punggung (INTAKE → MODULE → FINISH) dengan modul yang dipilih per unit.
//
// JANGAN menulis nama tahap di logika aplikasi. Kalau muncul dorongan menulis
// `if (stage.code === 'fit_test')`, berhenti dan pakai flag — atau tambahkan
// kolom flag baru di sini.
model RoutingStage {
  id       String     @id @default(uuid()) @db.Uuid
  code     String     @unique
  labelId  String     @map("label_id") // label bahasa Indonesia untuk UI
  phase    StagePhase
  sequence Int

  // NULL = berlaku untuk KEDUA lini. Diisi hanya kalau tahap eksklusif milik
  // satu lini (mis. Tambah Busa cuma ada di SERVICE).
  serviceLine ServiceLine? @map("service_line")

  isOptional Boolean @default(false) @map("is_optional")

  // Foto adalah produknya: bukti QC, pembelaan sengketa, baseline garansi,
  // sekaligus materi marketing.
  requiresPhoto Boolean @default(false) @map("requires_photo")

  // PAKAI FLAG INI, bukan perbandingan `code`.
  requiresQc Boolean @default(false) @map("requires_qc")

  // SENGAJA NULL di seed. Jangan ditebak — isi dari unit_stage_logs nyata
  // setelah beberapa minggu, lalu pakai untuk proyeksi tanggal janji.
  expectedDurationMinutes Int? @map("expected_duration_minutes")

  requiredRole Role?    @map("required_role")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  serviceModules ServiceCatalogModule[]
  unitsHere      Unit[]
  stageLogs      UnitStageLog[]
  qcFitTests     QcFitTest[]
  scopeRevisions ScopeRevision[]

  @@index([phase, sequence])
  @@map("routing_stages")
}

// Katalog layanan yang dijual. Layanan ketujuh = satu baris di sini + pemetaan
// modulnya, BUKAN routing template baru.
model ServiceCatalog {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  labelId     String      @map("label_id")
  serviceLine ServiceLine @map("service_line")
  active      Boolean     @default(true)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")

  modules ServiceCatalogModule[]
  units   Unit[]

  revisionsFrom ScopeRevision[] @relation("ScopeRevisionFrom")
  revisionsTo   ScopeRevision[] @relation("ScopeRevisionTo")

  @@map("service_catalog")
}

// Modul kerja yang dipakai sebuah layanan, beserta urutannya.
//
// DUA ATURAN yang TIDAK dipaksakan oleh constraint kolom dan karena itu wajib
// divalidasi di aplikasi kalau katalog nanti bisa diedit lewat UI:
//   1. stage yang dipetakan harus berfase MODULE
//   2. serviceLine stage harus sama dengan serviceLine layanan, atau NULL
//      (netral, mis. Ganti Kain) — mencampur lini dilarang (D-004)
// Keduanya diperiksa keras di blok verifikasi migrasi 20260731100200.
model ServiceCatalogModule {
  id        String         @id @default(uuid()) @db.Uuid
  serviceId String         @map("service_id") @db.Uuid
  service   ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stageId   String         @map("stage_id") @db.Uuid
  stage     RoutingStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sequence  Int

  @@unique([serviceId, stageId])
  @@index([serviceId])
  @@map("service_catalog_modules")
}

// Aksi yang dilakukan ke sebuah tahap. Cocok persis dengan PRD §5.1.
enum StageLogAction {
  START
  PAUSE
  COMPLETE
  FAIL
  SKIP
}

// Alasan blokir PRODUKSI (PRD §6.2). TERPISAH dari
// UnitStatus.READY_ON_CUSTOMER_HOLD — hold atas permintaan customer BUKAN
// blokir produksi (D-007); jamnya tidak boleh tercampur dengan alasan di sini.
enum BlockReason {
  MATERIAL_SHORTAGE
  AWAITING_CUSTOMER_APPROVAL
  MACHINE_DOWN
  QUALITY_ISSUE
  OTHER
}

// LEDGER APPEND-ONLY (Aturan #2). Generik untuk SEMUA tahap.
//
// Data spesifik Uji Berat Badan (verdict, override customer, edukasi yang
// diberikan — ROUTING.md §4) SENGAJA TIDAK di sini, supaya ledger generik ini
// tetap bersih. Itu tabel tersendiri, dibangun bersama transition engine.
//
// TIDAK ADA UPDATE/DELETE dari kode aplikasi. Koreksi = baris baru.
model UnitStageLog {
  id      String         @id @default(uuid()) @db.Uuid
  unitId  String         @map("unit_id") @db.Uuid
  unit    Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  stageId String         @map("stage_id") @db.Uuid
  stage   RoutingStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  action  StageLogAction

  // SetNull: pekerja resign, riwayat produksinya TETAP ada.
  actorId String? @map("actor_id")
  actor   User?   @relation("UnitStageLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")

  blockReason BlockReason? @map("block_reason")
  note        String?

  // Kolom siap pakai untuk requires_photo — belum ada endpoint upload yang
  // mengisinya di langkah ini; skemanya disiapkan lebih dulu supaya tidak
  // berubah lagi begitu upload disambungkan ke transition engine.
  photoUrls String[] @default([]) @map("photo_urls")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([unitId, createdAt])
  @@index([stageId, createdAt])
  @@map("unit_stage_logs")
}

enum JobType {
  PICKUP
  DELIVERY
}

// PRD §6.3, apa adanya.
enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  COMPLETED
  FAILED
  RESCHEDULED
}

// Job pickup/delivery. PRD §11 Phase 1 tadinya TANPA dispatch board/route
// builder/vehicle capacity — itu Phase 2. `sequence` di bawah adalah bagian
// Phase 2 yang SUDAH digarap (FR-L-03: urutan stop manual + jarak/durasi
// terhitung), vehicle capacity (FR-L-02, butuh entitas Vehicle) BELUM.
model Job {
  id      String  @id @default(uuid()) @db.Uuid
  type    JobType
  orderId String  @map("order_id")
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  scheduledDate DateTime? @map("scheduled_date") @db.Date
  timeWindow    String?   @map("time_window")

  driverId String?   @map("driver_id")
  driver   User?     @relation("JobDriver", fields: [driverId], references: [id], onDelete: SetNull)
  status   JobStatus @default(UNSCHEDULED)

  // Urutan stop dalam rute driver+tanggal+tipe hari itu (FR-L-03) — NULL
  // sampai dispatcher mengurutkan lewat PATCH /armada/route/reorder. Bukan
  // unique constraint: hanya perlu urutan RELATIF di dalam grup
  // driver+scheduledDate+type yang sama, tidak lintas grup.
  sequence Int? @map("sequence")

  // Snapshot alamat PER KUNJUNGAN, bukan tabel Address bersama — CRM ini
  // belum punya entitas Address (Customer cuma punya field "city"). PRD §5.1:
  // GPS yang benar didapat dari pin SUKSES PERTAMA di lapangan, jadi ini
  // properti kunjungan dulu; mendenormalisasi balik ke Customer adalah
  // keputusan terpisah, setelah datanya terbukti akurat.
  addressText String? @map("address_text")
  lat         Float?
  lng         Float?
  accessNotes String? @map("access_notes")

  // FR-D-07: setiap kegagalan WAJIB alasan + foto, tanpa kecuali.
  failureReason    String?  @map("failure_reason")
  failurePhotoUrls String[] @default([]) @map("failure_photo_urls")

  // FR-D-03/FR-D-04: foto kondisi (pickup) / penempatan (delivery) saat
  // job BERHASIL — bukti serah terima, terpisah dari failurePhotoUrls.
  proofPhotoUrls String[] @default([]) @map("proof_photo_urls")

  // Tanda tangan customer/penerima saat job selesai (Phase 2, PWA-lite).
  // OPSIONAL dengan sengaja — customer/penerima tidak selalu ada di tempat
  // saat serah terima (titip ke satpam/tetangga itu nyata di lapangan), jadi
  // ini lapisan kepercayaan TAMBAHAN di atas foto bukti (yang tetap WAJIB),
  // bukan pengganti atau syarat blocking. Gambar PNG hasil canvas, disimpan
  // lewat upload dir job-photos yang sama (bukan tabel/kolom terpisah untuk
  // tipe file) — satu tanda tangan per job, tidak butuh ledger.
  signatureUrl String? @map("signature_url")

  arrivedAt   DateTime? @map("arrived_at")
  completedAt DateTime? @map("completed_at")

  // Verifikasi Proof of Delivery (2 Agustus 2026, Tahap 4 Delivery). NULL =
  // belum direview (turunan "Belum Lengkap" vs "Menunggu Verifikasi" dihitung
  // di frontend dari ADA-TIDAKNYA proofPhotoUrls — tidak disimpan sebagai
  // status terpisah supaya tidak ada dua sumber kebenaran soal "sudah ada
  // fotonya belum").
  //
  // ⚠️ PENYIMPANGAN SADAR dari disiplin ledger (sama seperti ScopeRevision):
  // ini KOLOM biasa, bukan tabel event append-only. Admin BISA meninjau ulang
  // verdict (reject lalu verify lagi setelah driver diberi tahu perbaiki
  // fotonya) — kolom cukup untuk v1. Kalau nanti butuh riwayat "siapa reject
  // kapan, siapa verify kapan" karena ada sengketa, naikkan jadi tabel
  // podVerifications terpisah, pola yang sama dengan PaymentVerification.
  podStatus        PodStatus? @map("pod_status")
  podVerifiedById  String?    @map("pod_verified_by")
  podVerifiedBy    User?      @relation("PodVerifier", fields: [podVerifiedById], references: [id], onDelete: SetNull)
  podVerifiedAt    DateTime?  @map("pod_verified_at")
  podRejectionNote String?    @map("pod_rejection_note")

  // Reschedule setelah gagal (2 Agustus 2026, Tahap 5 Delivery — Kendala &
  // Reschedule). SEBELUM INI: job berstatus FAILED adalah JALAN BUNTU —
  // PATCH /jobs/:id menolak apa pun selain UNSCHEDULED/SCHEDULED/ASSIGNED,
  // jadi tidak ada cara menjadwalkan ulang job yang gagal tanpa membuat job
  // baru dari nol (kehilangan jejak kegagalan aslinya). Ini gap fungsional
  // NYATA, bukan penyempurnaan kosmetik.
  //
  // rescheduleReason MENJAWAB "kenapa dijadwalkan ulang" — TERPISAH dari
  // failureReason ("kenapa gagal") karena dua pertanyaan berbeda: gagal bisa
  // karena "pelanggan tidak di tempat", dijadwalkan ulang karena "pelanggan
  // minta besok siang". Menimpa failureReason akan menghapus jejak kegagalan
  // aslinya.
  rescheduleReason            String?   @map("reschedule_reason")
  rescheduledAt               DateTime? @map("rescheduled_at")
  rescheduledById             String?   @map("rescheduled_by")
  rescheduledBy               User?     @relation("JobRescheduler", fields: [rescheduledById], references: [id], onDelete: SetNull)
  // FR: konfirmasi pelanggan atas jadwal baru. Boolean, BUKAN dianggap benar
  // secara default — dispatcher harus secara sadar mencentangnya, dan itu
  // sengaja bisa TIDAK dicentang (jadwal baru diajukan tapi belum sempat
  // dikonfirmasi ke pelanggan, mis. rencana internal dulu).
  customerConfirmedReschedule Boolean   @default(false) @map("customer_confirmed_reschedule")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Kendaraan & rute (2 Agustus 2026, Tahap 3 Delivery). Keduanya NULLABLE:
  // job bisa dijadwalkan sebelum kendaraan/rutenya ditetapkan, dan itu justru
  // keadaan yang dipantau papan dispatcher ("belum ada armada").
  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  routeId   String?  @map("route_id") @db.Uuid
  route     Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  units         JobUnit[]
  payments      Payment[]
  revisionLinks UnitRevision[]

  @@index([orderId])
  @@index([driverId, scheduledDate]) // "job saya hari ini" driver
  @@index([status, scheduledDate]) // papan Armada
  @@index([routeId, sequence]) // urutan stop dalam satu rute
  @@index([vehicleId])
  @@index([podStatus])
  @@map("jobs")
}

// Hasil review Proof of Delivery. Bukan "lulus/gagal" biasa — REJECTED
// berarti driver diminta memperbaiki bukti (foto ulang/tanda tangan ulang),
// bukan pekerjaannya batal. Job tetap COMPLETED, hanya buktinya ditandai
// perlu diperbaiki.
enum PodStatus {
  VERIFIED
  REJECTED
}

// ─── REVISI (Delivery Tahap 6, disebut "Retur" di menu) ────────────────────
//
// KOREKSI PENTING (2 Agustus 2026): fitur di spesifikasi bernama "Retur"
// dengan model refund/replace/reject — itu BUKAN cara bisnis ini bekerja.
// Konfirmasi langsung dari Gilang: kalau kasur sudah diantar lalu customer
// merasa TEKSTURNYA kurang pas (trial kenyamanan 7/30 hari — lihat §16.8
// CLAUDE.md), tim BAWA LAGI kasurnya dan REVISI (adjust lapisan/racikan) —
// diulang sampai customer bilang "yes", BUKAN dikembalikan uangnya. Sano
// Care juga punya garansi amblas 10-20 tahun yang jalur klaimnya SAMA:
// bawa kembali, revisi, antar ulang.
//
// Karena itu bisa terjadi BERKALI-KALI untuk satu Unit yang sama (revisi
// pertama belum pas, revisi kedua baru "yes"), ini TABEL, bukan kolom di
// Unit — riwayat tiap percobaan tetap terlihat, konsisten dengan prinsip
// ledger (Aturan #2) yang dipakai unit_stage_logs.
//
// jobId SENGAJA pointer tunggal, bukan tabel/relasi kompleks: dispatcher
// membuat Job pickup/delivery SEPERTI BIASA lewat halaman Jadwal &
// Penugasan (JobUnit yang menghubungkan Job↔Unit sudah ada), lalu
// menempelkan job yang sedang menangani revisi ini di sini — bukan
// membangun ulang mesin dispatch yang sudah ada.
enum RevisionTrigger {
  KENYAMANAN // trial period comfort — customer minta tekstur diubah
  GARANSI // klaim garansi amblas/kempes
}

enum RevisionStatus {
  REQUESTED // baru diajukan, belum ada job jemput
  PICKUP_SCHEDULED // job jemput sudah dibuat & ditempelkan (jobId terisi)
  IN_REWORK // unit sudah di tangan tim, sedang direvisi
  READY_REDELIVER // revisi selesai, siap diantar ulang
  REDELIVERED // sudah diantar ulang, menunggu konfirmasi customer
  CONFIRMED // customer bilang "yes" — selesai
  CANCELLED // dibatalkan (customer berubah pikiran, dst)
}

model UnitRevision {
  id     String @id @default(uuid()) @db.Uuid
  unitId String @map("unit_id") @db.Uuid
  // Restrict: unit yang punya riwayat revisi tidak boleh terhapus diam-diam.
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  trigger   RevisionTrigger
  complaint String // keluhan/alasan customer, wajib diisi saat pengajuan

  status RevisionStatus @default(REQUESTED)

  // Job pickup/delivery yang SEDANG menangani revisi ini — SetNull karena
  // job bisa dihapus/diganti tanpa menghapus riwayat revisinya.
  jobId String? @map("job_id") @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  note        String? // catatan tim (apa yang direvisi, hasil inspeksi, dst)
  confirmedAt DateTime? @map("confirmed_at")

  // SetNull: staf resign, riwayat revisi TETAP ada.
  createdById String? @map("created_by")
  createdBy   User?   @relation("UnitRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([status])
  @@map("unit_revisions")
}

// ─── ARMADA (PRD §5.1 Vehicle) ──────────────────────────────────────────────
//
// Ditambahkan 2 Agustus 2026. Sebelumnya kendaraan tidak ada sama sekali di
// sistem — dispatcher menugaskan driver, dan kendaraan diingat di kepala.
// Akibatnya kapasitas tidak bisa dicek (FR-L-02) dan Route Planner tidak
// mungkin dibangun.
//
// AMAN dilakukan sekarang: saat migrasi ini ditulis, tabel `jobs` masih KOSONG
// (0 baris) — jadi tidak ada data yang perlu ditebak-tebak kendaraannya.
// Menunda ini sampai job sudah banyak berarti harus menebak kendaraan untuk
// ratusan job historis, dan tebakan itu akan masuk ke laporan utilisasi armada.
enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id          String @id @default(uuid()) @db.Uuid
  plateNumber String @unique @map("plate_number")

  // String bebas, BUKAN enum: armada bisa bertambah tipe (motor box, truk
  // engkel) tanpa perlu migrasi enum tiap kali. Tidak ada logika aplikasi
  // yang bercabang berdasarkan nilai ini — kapasitas yang dipakai, bukan tipe.
  type String

  // PRD §5.1: kapasitas dihitung SLOT, bukan jumlah kasur — king dan single
  // memakan ruang berbeda di bak yang sama. Konversi ukuran→slot menyusul
  // bersama Route Planner; kolom ini menyimpan kapasitas totalnya.
  capacitySlots Int @map("capacity_slots")

  status VehicleStatus @default(AVAILABLE)
  active Boolean       @default(true)

  mileageKm       Int?      @map("mileage_km")
  nextServiceDate DateTime? @map("next_service_date") @db.Date
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs   Job[]
  routes Route[]

  @@index([status])
  @@map("vehicles")
}

// ─── RUTE (PRD §5.1 Route, FR-L-03) ─────────────────────────────────────────
//
// SEBELUM INI "rute" hanya IMPLISIT: sekumpulan job yang kebetulan punya
// driver + tanggal + tipe yang sama, diurutkan kolom `sequence`
// (lihat PATCH /armada/route/reorder). Bentuk itu tidak bisa menyimpan
// STATUS — tidak ada tempat untuk "draft yang belum diterbitkan", padahal
// Route Planner justru butuh dispatcher menyusun rencana dulu baru
// menerbitkannya ke driver.
//
// `driverId`/`vehicleId` di sini adalah RENCANA. Job tetap punya driverId-nya
// sendiri (yang SUDAH dipakai query "job saya hari ini" milik driver, dan
// TIDAK diubah migrasi ini) — saat rute diterbitkan, nilai dari sini disalin
// ke job-nya. Dua kolom, dua arti: rencana vs penugasan yang berlaku.
enum RouteStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Route {
  id   String   @id @default(uuid()) @db.Uuid
  code String   @unique // terbaca manusia, mis. RTE-020826-01
  date DateTime @db.Date

  driverId String? @map("driver_id")
  driver   User?   @relation("RouteDriver", fields: [driverId], references: [id], onDelete: SetNull)

  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status RouteStatus @default(DRAFT)

  // Estimasi hasil perencanaan, BUKAN hasil pengukuran lapangan. Diisi
  // dispatcher/kalkulasi jarak; realisasinya nanti dibaca dari job.
  plannedDistanceKm  Decimal? @map("planned_distance_km") @db.Decimal(8, 2)
  plannedDurationMin Int?     @map("planned_duration_min")

  publishedAt DateTime? @map("published_at")
  notes       String?

  createdById String? @map("created_by")
  createdBy   User?   @relation("RouteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@index([date, status]) // papan Route Planner per tanggal
  @@index([driverId, date])
  @@map("routes")
}

// Job membawa SEBAGIAN unit sebuah order, bukan selalu semuanya (D-006:
// pengiriman hotel bertahap — tahap 1: 15 kasur, tahap 2: 15 kasur).
model JobUnit {
  id     String @id @default(uuid()) @db.Uuid
  jobId  String @map("job_id") @db.Uuid
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([jobId, unitId])
  @@index([unitId])
  @@map("job_units")
}

// Pembayaran tunai ke driver (D-011). APPEND-ONLY (CLAUDE.md sano-hub §"Dua
// aturan": payments ada di daftar ledger yang cuma boleh INSERT) — verifikasi
// finance BUKAN kolom yang di-UPDATE di baris ini, itu baris BARU di
// PaymentVerification. "Sudah diverifikasi?" = ADA baris verifikasi untuk
// payment ini, bukan status yang bisa berubah bolak-balik.
// D-023: orderId WAJIB (ledger selalu bisa dijawab "untuk order mana"),
// jobId OPSIONAL (DP di konfirmasi order terjadi SEBELUM job pickup/delivery
// mana pun ada — FR-M-01). Payment yang dicatat driver di stop pengiriman
// (D-011) tetap mengisi keduanya (orderId diturunkan dari job.orderId saat
// dicatat, bukan diminta manual ke driver).
model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  jobId String? @map("job_id") @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  amount        Int // Rupiah, integer
  method        PaymentMethod
  proofPhotoUrl String?       @map("proof_photo_url")

  // Restrict, BUKAN SetNull: siapa yang mencatat penerimaan uang adalah inti
  // jejak audit ini — kalau pencatatnya (driver) dihapus, baris ini justru
  // TIDAK BOLEH kehilangan jejak pelakunya. Hapus user driver harus diblokir
  // selama masih ada Payment atas namanya (beda dari Job.driverId yang boleh
  // SetNull — itu cuma penugasan kerja, bukan pencatatan uang).
  recordedById String @map("recorded_by")
  recordedBy   User   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  verifications PaymentVerification[]

  @@index([orderId])
  @@index([jobId])
  @@index([recordedById, createdAt]) // rekonsiliasi harian per driver
  @@map("payments")
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

// Verifikasi finance atas satu Payment — baris terpisah, BUKAN kolom
// verifiedAt/verifiedById di Payment, supaya Payment tetap murni
// append-only (lihat catatan di atas).
model PaymentVerification {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  verifiedById String @map("verified_by")
  verifiedBy   User   @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([paymentId]) // satu payment cuma diverifikasi sekali
  @@map("payment_verifications")
}

// Target produksi harian (D-014). Kepala produksi menetapkan pagi hari unit
// mana saja yang dikerjakan; sebelum tutup hasilnya di-update.
//
// Ini yang membuat "target hari ini tercapai berapa?" bisa dijawab — tanpa
// tabel ini yang tersimpan cuma apa yang TERJADI, bukan apa yang DIRENCANAKAN.
//
// Per UNIT, bukan per order: order hotel 15 kasur tidak selalu dikerjakan
// sekaligus dalam satu hari. UI boleh menampilkan/memilih per order — itu
// urusan tampilan.
//
// BUKAN ledger append-only (beda dari UnitStageLog): salah pilih target lalu
// dibatalkan itu wajar dan tidak punya nilai audit. Yang append-only tetap
// hasil kerja sebenarnya.
model ProductionTarget {
  id         String   @id @default(uuid()) @db.Uuid
  // DATE polos — ini "hari kerja", bukan instant. Rentang WIB diterjemahkan
  // di tepi (backend/src/utils/wib.js).
  targetDate DateTime @map("target_date") @db.Date
  unitId     String   @map("unit_id") @db.Uuid
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // SetNull: kepala produksi resign, riwayat targetnya TETAP ada.
  createdById String? @map("created_by")
  createdBy   User?   @relation("ProductionTargetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([targetDate, unitId])
  @@index([targetDate])
  @@index([unitId])
  @@map("production_targets")
}

enum FitVerdict {
  TERLALU_KERAS
  PAS
  TERLALU_EMPUK
}

enum PreferenceOverride {
  LEBIH_KERAS
  LEBIH_EMPUK
}

// Verdict Uji Berat Badan (D-005, ROUTING.md §4). TERPISAH dari
// UnitStageLog generik — bentuknya sendiri (keras/pas/empuk, berat acuan,
// override customer) tidak masuk akal dipaksakan ke kolom "note" biasa.
//
// D-009: override customer yang menyimpang dari rekomendasi berat badan
// adalah catatan LIABILITY, bukan preferensi biasa — kalau customer memaksa
// lalu komplain nyeri di kemudian hari, baris ini pembelaan garansinya.
// educationGiven WAJIB true kalau override terisi, dipaksakan CHECK
// constraint di database (lihat migration.sql), bukan cuma validasi kode.
model QcFitTest {
  id      String       @id @default(uuid()) @db.Uuid
  unitId  String       @map("unit_id") @db.Uuid
  unit    Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  stageId String       @map("stage_id") @db.Uuid
  stage   RoutingStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  verdict           FitVerdict
  referenceWeightKg Int        @map("reference_weight_kg")

  customerPreferenceOverride PreferenceOverride? @map("customer_preference_override")
  educationGiven             Boolean             @default(false) @map("education_given")

  testedById String? @map("tested_by_id")
  testedBy   User?   @relation("QcFitTestTester", fields: [testedById], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([unitId, createdAt])
  @@map("qc_fit_tests")
}

// ─── REVISI SCOPE (PRD §7.4 / FR-R, D-008) ──────────────────────────────────
//
// Kejadian PALING UMUM di restorasi kasur: kasur dibongkar, kondisi aslinya
// lebih parah dari dugaan survei, harga harus berubah. Hari ini itu
// dinegosiasikan lewat WhatsApp lalu hilang — dan total order diam-diam
// menyimpang dari yang benar-benar ditagih.
//
// Menempel ke UNIT, bukan Order (D-002): order berisi 2 kasur bisa punya
// revisi di satu kasur saja. `orderId` didenormalisasi supaya pertanyaan
// "revisi ini untuk order mana" selalu bisa dijawab tanpa join lewat unit.
//
// TITIK PEMICUNYA `foundation_test` (Uji Fondasi) — di situlah lini & modul
// DITETAPKAN, bukan saat sales input order (ROUTING.md §5). Tapi `stageId`
// di bawah TIDAK dibatasi ke tahap tertentu di skema: tahap adalah DATA
// (D-003), dan mengunci nama tahap di sini akan mengulang persis anti-pattern
// yang dilarang CLAUDE.md sano-hub.
enum ScopeRevisionStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIAL // FR-R-04: customer setuju sebagian
}

// Lewat mana persetujuan didapat — FR-R-04 mewajibkan bukti, dan bukti
// berbeda bentuknya per kanal (screenshot WA vs catatan telepon).
enum ScopeRevisionVia {
  WHATSAPP
  TELEPON
  LANGSUNG
  LAINNYA
}

model ScopeRevision {
  id String @id @default(uuid()) @db.Uuid

  // Restrict: menghapus unit yang punya riwayat negosiasi harga harus GAGAL
  // KERAS, sama alasannya dengan Unit→Order.
  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Tahap saat revisi diajukan. Dipakai FR-R-06 ("revision rate by stage") —
  // revisi yang selalu muncul di tahap yang sama adalah sinyal proses survei
  // yang salah, bukan sekadar statistik.
  stageId String?       @map("stage_id") @db.Uuid
  stage   RoutingStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  // Layanan sebelum → usulan. FK ke katalog, BUKAN teks bebas: perubahan
  // layanan mengubah modul kerja yang dilalui unit, jadi harus bisa
  // di-resolve jadi routing, bukan sekadar dibaca manusia.
  fromServiceId String?         @map("from_service_id") @db.Uuid
  fromService   ServiceCatalog? @relation("ScopeRevisionFrom", fields: [fromServiceId], references: [id], onDelete: Restrict)
  toServiceId   String?         @map("to_service_id") @db.Uuid
  toService     ServiceCatalog? @relation("ScopeRevisionTo", fields: [toServiceId], references: [id], onDelete: Restrict)

  reason String // temuan bongkar — kenapa harganya harus berubah

  // Rupiah INTEGER (CLAUDE.md: jangan float untuk uang). Boleh negatif:
  // temuan bisa membuat pekerjaan lebih ringan, bukan cuma lebih mahal.
  deltaAmount Int @map("delta_amount")

  // FR-R-03: ringkasan ke customer berisi foto + sebelum/sesudah + delta.
  // Fotonya di sini, bukan menumpang unit_stage_logs — bukti negosiasi harga
  // punya umur simpan & kepentingan hukum yang berbeda dari foto proses.
  photoUrls String[] @default([]) @map("photo_urls")

  status ScopeRevisionStatus @default(PENDING)

  // ── Keputusan — diisi SEKALI, dijaga di service layer ────────────────────
  // Ini SATU-SATUNYA kolom yang berubah setelah baris dibuat, dan itu
  // penyimpangan yang disadari dari disiplin append-only: ScopeRevision tidak
  // termasuk daftar ledger (unit_stage_logs, stock_movements, payments,
  // audit_log). Yang penting tetap terekam permanen — siapa memutuskan, kapan,
  // lewat kanal apa, dengan bukti apa. Memutuskan ulang DITOLAK (409).
  decidedById  String?           @map("decided_by")
  decidedBy    User?             @relation("ScopeRevisionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?         @map("decided_at")
  decidedVia   ScopeRevisionVia? @map("decided_via")
  evidenceUrl  String?           @map("evidence_url") // screenshot WA (FR-R-04)
  decisionNote String?           @map("decision_note")

  // OrderItem yang dibuat saat disetujui. Delta harga TIDAK PERNAH ditulis
  // ke Order.value langsung — value dihitung dari SUM(items.harga) lewat
  // syncOrderValue(), dan menulisnya langsung adalah sumber bug yang sudah
  // tercatat (D-012: "header Rp1.000.000 tapi breakdown Total: Rp0").
  // Menyimpan tautannya juga yang membuat approve dua kali tidak menggandakan
  // tagihan.
  orderItemId String? @map("order_item_id")

  createdById String?  @map("created_by")
  createdBy   User?    @relation("ScopeRevisionProposer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([unitId, createdAt])
  @@index([orderId])
  @@index([status]) // papan "revisi menunggu jawaban customer"
  @@index([stageId]) // FR-R-06
  @@map("scope_revisions")
}

// Riwayat perpindahan STATUS ORDER (append-only) — pasangan dari
// pipeline_transitions, tapi untuk sisi PENGERJAAN bukan penjualan.
// Order.status hanya menyimpan posisi SEKARANG; tabel ini yang membuat
// pertanyaan "kenapa order ini lama?" bisa dijawab: berapa hari tertahan di
// Diproses, kapan pindah ke Siap Kirim, siapa yang memindahkan.
//
// TIDAK BISA DI-BACKFILL: perpindahan sebelum tabel ini ada tidak terekam,
// jadi laporan kecepatan produksi baru bermakna setelah beberapa minggu
// pemakaian (pola & peringatan yang sama seperti pipeline_transitions —
// lihat empty state di features/laporan/components/PipelineTab.jsx).
//
// Ditulis dalam SATU transaksi dengan update Order.status (routes/orders.js
// PATCH /:id), dan HANYA kalau status benar-benar berubah — form order sering
// mengirim seluruh field termasuk status yang sama, dan riwayat penuh baris
// "PENDING → PENDING" membuat perhitungan durasi tidak berguna.
//
// CATATAN RELASI (penting untuk script merge customer): FK-nya ke Order
// (Cascade), BUKAN ke Customer. Order sendiri memakai RESTRICT ke Customer,
// jadi merge customer yang masih punya order akan GAGAL KERAS — bukan
// menghapus riwayat ini diam-diam. Lihat peringatan di CLAUDE.md §5.
model OrderStatusTransition {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @map("order_id")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus @map("from_status")
  toStatus   OrderStatus @map("to_status")

  // Nullable + SetNull: kalau user dihapus, riwayat produksi TETAP ada
  // (data operasional tidak boleh hilang karena pegawai resign).
  changedById String? @map("changed_by")
  changedBy   User?   @relation("OrderStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") // UTC — lihat src/utils/wib.js

  @@index([orderId, createdAt]) // timeline per order
  @@index([toStatus, createdAt]) // "berapa masuk Siap Kirim per periode"
  @@map("order_status_transitions")
}

// Counter sequence untuk generate nomor order otomatis per prefix+bulan+tahun
model OrderSequence {
  id      String @id @default(cuid())
  prefix  String // "RES" | "SWS" | "NEW"
  year    Int
  month   Int
  lastSeq Int    @default(0)

  @@unique([prefix, year, month])
}

// Item layanan dalam satu order (kasur, upgrade, servis, dsb.)
// Satu Order bisa punya banyak OrderItem
model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  layananName String
  harga       Int
  sortOrder   Int    @default(0)
}

// Berat badan per orang dalam satu order (multi-orang, misal suami + istri)
model OrderWeightEntry {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String // "Suami" | "Istri" | "Sendiri" | custom
  beratKg   Int
  sortOrder Int    @default(0)
}

// Target penjualan bulanan per sales person
model SalesTarget {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  year        Int
  month       Int // 1-12
  targetValue Int // Rupiah
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year, month])
}

// Pesan masuk yang tidak bisa diselesaikan nomornya (LID tidak dikenal, JID tidak valid).
// Disimpan untuk review manual — JANGAN buat Customer dengan nomor sampah.
model UnresolvedMessage {
  id          String    @id @default(cuid())
  rawJid      String // JID mentah yang gagal di-resolve
  session     String // session WAHA yang mengirim
  reason      String // "LID_UNRESOLVABLE" | "INVALID_JID"
  payloadJson String    @db.Text // JSON payload lengkap untuk diagnostik / retry manual
  createdAt   DateTime  @default(now())
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?

  @@index([createdAt])
}

// Hasil nightly reconciliation job: mencatat perbedaan jumlah pesan WAHA vs DB
model SyncDiscrepancy {
  id             String   @id @default(cuid())
  phone          String
  conversationId String?
  wahaCount      Int
  dbCount        Int
  difference     Int
  checkedAt      DateTime @default(now())

  @@index([checkedAt])
}

// Cache resolusi LID (Local ID WhatsApp) → nomor telepon asli
// GOWS kadang kirim JID format @lid alih-alih @s.whatsapp.net.
// Setiap berhasil resolve via WAHA API, hasilnya di-cache di sini supaya
// tidak perlu panggil API berulang untuk nomor yang sama.
model LidMapping {
  id          String   @id @default(cuid())
  lid         String   @unique // angka LID saja, tanpa suffix @lid
  phoneNumber String // nomor asli format 628xxx
  session     String // session WAHA yang berhasil resolve
  resolvedAt  DateTime @default(now())
}

// Riwayat chat AI Playground — tersimpan per model config (id dari ai-models.json)
model PlaygroundMessage {
  id            String   @id @default(cuid())
  modelConfigId String
  role          String // "user" | "assistant"
  content       String
  modelName     String? // nama display model, denormalized untuk badge di UI
  modelProvider String? // "anthropic" | "openai" | "gemini"
  modelStr      String? // model string e.g. "claude-sonnet-4-6"
  createdAt     DateTime @default(now())

  @@index([modelConfigId])
}

// ─── WAVE 4B — AI SALES ASSISTANT (draft-only, human-in-the-loop) ────────────
// Log AUDIT append-only untuk setiap permintaan draf balasan AI. ADDITIVE:
// TIDAK ada FK ke tabel lain (userId/conversationId/customerId = string biasa)
// supaya benar-benar terisolasi & reversible (rollback = DROP TABLE + DROP TYPE).
// Bukan jalur kirim — status SENT hanya menandai sales mengirim MANUAL lewat
// compose WhatsApp yang sudah ada; TIDAK PERNAH berarti AI mengirim pesan.
enum ReplySuggestionStatus {
  GENERATED // AI membuat draf
  COPIED // sales menyalin draf manual (UI 4B.1)
  EDITED // sales mengubah draf (UI 4B.1)
  SENT // sales mengirim MANUAL via compose WA yang sudah ada — BUKAN AI yang kirim
  DISMISSED // sales mengabaikan draf (UI 4B.1)
  BLOCKED // AI mencegah generate (komplain/handover/aturan keamanan)
}

enum ReplySuggestionFeedback {
  POSITIVE // "berguna"
  NEGATIVE // "tidak berguna"
}

model ReplySuggestionLog {
  id              String                   @id @default(cuid())
  conversationId  String? // string biasa (tanpa FK) — isolasi
  customerId      String? // string biasa (tanpa FK) — isolasi
  userId          String // peminta (req.user.id)
  intent          String? // intent utama yang terdeteksi
  status          ReplySuggestionStatus    @default(GENERATED)
  blocked         Boolean                  @default(false)
  blockedReason   String? // COMPLAINT | HANDOVER_REQUEST | ASSISTANT_DISABLED | ...
  source          String? // "llm" | "template"
  model           String?
  inputTokens     Int                      @default(0)
  outputTokens    Int                      @default(0)
  costUsd         Float                    @default(0)
  suggestionCount Int                      @default(0)
  feedback        ReplySuggestionFeedback? // NULL sampai diberi (UI 4B.1)
  createdAt       DateTime                 @default(now())

  @@index([userId, createdAt]) // penghitung kuota harian per-user
  @@index([createdAt]) // rollup biaya bulanan
}

// ─────────────────────────────────────────────────────────────────────────
// INVENTORY v1 (Phase 3, PRD §8 — "the part that must be right"). Scope
// SENGAJA dipersempit dari PRD lengkap (disepakati dengan Gilang 1 Agustus
// 2026): katalog material + ledger + goods receipt + issue manual + stock
// opname. DITUNDA ke iterasi berikutnya — jangan tergoda menambah sekarang
// (CLAUDE.md §"Jangan membangun untuk nanti"): BoM auto-expand saat order
// dikonfirmasi, foam remnant per-sheet (§8.2 PRD), reservasi vs
// available-to-promise (§8, FR-I-03), reorder point alert (FR-I-05), yield
// report (FR-I-08). Struktur di bawah ini SENGAJA tidak menutup jalan ke
// fitur itu (materialId + location sudah cukup umum), tapi juga tidak
// mencoba menebak bentuknya sekarang.

enum MaterialUnit {
  PCS
  METER
  M3 // meter kubik — busa, dihitung per PRD §8.2 (walau remnant per-sheet-nya sendiri ditunda)
  SHEET
  SPOOL
  KG
}

enum StockMovementType {
  RECEIPT // masuk dari supplier (FR-I-01)
  ISSUE // keluar, dipakai ke unit produksi (FR-P-08)
  RETURN // sisa material kembali ke gudang
  WASTE // terbuang/rusak, WAJIB alasan
  ADJUSTMENT // hasil stock opname, WAJIB alasan (FR-I-06)
  TRANSFER // Warehouse Tahap 4 — perpindahan antar StorageLocation, dua baris per StockTransfer (keluar+masuk), net 0 di saldo total
}

// Katalog material — BUKAN ledger, boleh diedit (nama, status aktif).
// `serviceLine` NULL = dipakai lintas lini (benang, plastik wrap); terisi =
// khusus SERVICE atau UPGRADE (D-004: dua lini tidak boleh campur material).
// Kategori item gudang (Warehouse Tahap 2, 2 Agustus 2026).
//
// KENAPA BARU SEKARANG: v1 katalog cuma membedakan material lewat
// `serviceLine` (SERVICE/UPGRADE) — cukup saat isinya HANYA bahan baku
// bengkel. Begitu gudang juga menyimpan barang setengah jadi dan produk
// jadi, "lini layanan" tidak lagi bisa menjawab "ini barang jenis apa".
//
// AMAN DILAKUKAN SEKARANG: tabel `materials` masih KOSONG di production
// (0 baris, diverifikasi langsung sebelum migrasi ini ditulis) — nol data
// yang perlu ditebak kategorinya. Menunda sampai katalog terisi ratusan
// item berarti menebak kategori untuk data lama, dan tebakan itu akan
// masuk ke laporan nilai inventory per kategori.
enum MaterialCategory {
  RAW_MATERIAL // busa, kain, per, lem, benang, resleting, packaging
  WIP // barang setengah jadi: cutting, quilting, mattress core
  FINISHED_GOODS // kasur, bantal, guling, protector siap jual
  CONSUMABLE // barang pakai habis & non-inventory: tools, ATK, kebersihan
}

model Material {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique // mis. "FOAM-HR-D44-5CM", "FABRIC-KNIT-QUILT"
  name        String
  unit        MaterialUnit
  serviceLine ServiceLine? @map("service_line")

  // NULLABLE dengan sengaja: material lama (kalau kelak ada yang dibuat
  // sebelum kolom ini) tidak dipaksa masuk kategori tebakan. UI menampilkan
  // "Tanpa kategori" apa adanya, bukan menyamarkannya jadi RAW_MATERIAL.
  category MaterialCategory?

  active Boolean @default(true)

  // Reorder alert (PRD FR-I-05), D-024. Keduanya OPSIONAL dengan sengaja —
  // tidak semua material perlu dipantau (bahan langka/sekali pakai tidak
  // relevan direstok). reorderPoint null = alert MATI untuk material itu,
  // bukan "reorder di titik nol". Angka MANUAL diisi gudang, BUKAN dihitung
  // otomatis dari histori pemakaian — v1 belum punya data konsumsi cukup
  // untuk forecast yang jujur, mengarang formula akan lebih menyesatkan
  // daripada tidak ada alert sama sekali.
  reorderPoint Float? @map("reorder_point")
  reorderQty   Float? @map("reorder_qty")

  createdAt DateTime @default(now()) @map("created_at")

  movements               StockMovement[]
  goodsReceiptLines       GoodsReceiptLine[]
  materialIssueLines      MaterialIssueLine[]
  stockTransferLines      StockTransferLine[]
  stockCountLines         StockCountLine[]
  damagedStockRecords     DamagedStockRecord[]
  returnRecords           ReturnRecord[]
  stockAdjustmentRequests StockAdjustmentRequest[]
  replenishmentRequests   ReplenishmentRequest[]

  @@index([active])
  @@map("materials")
}

// Ledger APPEND-ONLY (PRD §8.1: "Never store current_qty as a mutable
// column" — prinsip yang SAMA dengan unit_stage_logs di area Bengkel).
// Stok dihitung on-the-fly lewat SUM(qty) per material (lihat routes/
// inventory.js GET /stock) — BUKAN materialized view seperti disarankan
// PRD, sengaja disederhanakan: volume data di v1 ini kecil, agregasi
// langsung selalu akurat (tidak ada risiko view basi) dan tidak perlu
// infrastruktur refresh/cron tambahan. Revisit kalau volume sudah besar.
model StockMovement {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  type StockMovementType

  // SELALU dalam satuan Material.unit. Tanda ikut arah: RECEIPT/RETURN
  // positif, ISSUE/WASTE negatif, ADJUSTMENT bisa dua-duanya (variasi bisa
  // lebih atau kurang dari hitungan sistem). Decimal(12,4) — cukup presisi
  // untuk m³ busa (PRD §8.2 contoh: 0.152 m³).
  qty Decimal @db.Decimal(12, 4)

  // v1: string bebas, BUKAN tabel Location terpisah (YAGNI — belum ada
  // kebutuhan nyata multi-gudang). Default satu lokasi supaya endpoint yang
  // tidak peduli lokasi tetap sederhana.
  location String @default("GUDANG_UTAMA")

  // ISSUE ke unit produksi (FR-P-08) — NULL untuk movement yang tidak
  // terikat ke unit tertentu (RECEIPT, ADJUSTMENT hasil stock opname).
  unitId String? @map("unit_id") @db.Uuid
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Diisi saat RECEIPT (FR-I-01: "records qty, unit cost, supplier,
  // batch") — bukan fitur tambahan, ini bagian inti goods receipt.
  unitCost    Int?    @map("unit_cost") // Rupiah per satuan
  supplier    String?
  batchNumber String? @map("batch_number")

  // WAJIB diisi untuk WASTE dan ADJUSTMENT (FR-I-06: "system records
  // variance as an ADJUSTMENT movement with mandatory reason") — validasi
  // di route handler, bukan constraint DB (beda jenis movement beda aturan).
  reason String?
  note   String?

  // SetNull, bukan Restrict: pegawai gudang resign, riwayat pergerakan
  // stok TETAP ada — sama prinsipnya dengan aktor di unit_stage_logs.
  createdById String? @map("created_by")
  createdBy   User?   @relation("StockMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // Warehouse Tahap 2B (2 Agustus 2026) — jejak balik ke dokumen goods
  // receipt yang MENGHASILKAN baris RECEIPT ini. NULLABLE: movement RECEIPT
  // lama (sebelum GoodsReceipt ada) dan movement non-RECEIPT tidak punya
  // dokumen sumber. SetNull, bukan Restrict: menghapus draft GoodsReceipt
  // yang batal TIDAK BOLEH menghapus jejak stok yang sudah kadung tercatat.
  goodsReceiptId String?       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  // Warehouse Tahap 3 — jejak balik ke Material Issue yang menghasilkan
  // baris ISSUE ini. NULLABLE: movement ISSUE lama (lewat POST
  // /movements/issue langsung ke unit) tidak punya dokumen alur approval.
  materialIssueId String?        @map("material_issue_id") @db.Uuid
  materialIssue   MaterialIssue? @relation(fields: [materialIssueId], references: [id], onDelete: SetNull)

  // Warehouse Tahap 4 — jejak balik ke Stock Transfer. Satu transfer
  // menghasilkan DUA baris (keluar di asal, masuk di tujuan) yang
  // sama-sama menempel ke id ini.
  stockTransferId String?        @map("stock_transfer_id") @db.Uuid
  stockTransfer   StockTransfer? @relation(fields: [stockTransferId], references: [id], onDelete: SetNull)

  // Warehouse Tahap 5 — jejak balik ke sesi Stock Count yang menghasilkan
  // baris ADJUSTMENT ini (kalau lewat StockCount, bukan endpoint adjustment
  // satu langkah yang sudah ada sejak v1).
  stockCountId String?     @map("stock_count_id") @db.Uuid
  stockCount   StockCount? @relation(fields: [stockCountId], references: [id], onDelete: SetNull)

  // Warehouse Tahap 6 — jejak balik ke masing-masing dokumen resolusi.
  damagedStockRecordId     String?                 @map("damaged_stock_record_id") @db.Uuid
  damagedStockRecord       DamagedStockRecord?     @relation(fields: [damagedStockRecordId], references: [id], onDelete: SetNull)
  returnRecordId           String?                 @map("return_record_id") @db.Uuid
  returnRecord             ReturnRecord?           @relation(fields: [returnRecordId], references: [id], onDelete: SetNull)
  stockAdjustmentRequestId String?                 @map("stock_adjustment_request_id") @db.Uuid
  stockAdjustmentRequest   StockAdjustmentRequest? @relation(fields: [stockAdjustmentRequestId], references: [id], onDelete: SetNull)

  @@index([materialId, createdAt]) // saldo & riwayat per material
  @@index([unitId]) // "material apa saja yang dipakai unit ini"
  @@index([goodsReceiptId])
  @@index([materialIssueId])
  @@index([stockTransferId])
  @@index([stockCountId])
  @@index([damagedStockRecordId])
  @@index([returnRecordId])
  @@index([stockAdjustmentRequestId])
  @@map("stock_movements")
}

// ─── GOODS RECEIPT (Warehouse Tahap 2B, 2 Agustus 2026) ────────────────────
//
// KENAPA BARU SEKARANG. v1 inventory (routes/inventory.js) cuma punya
// POST /movements/receipt — SATU langkah, langsung tercatat ke ledger. Itu
// cukup untuk "barang sudah di tangan, catat sekarang", tapi tidak bisa
// menjawab "supplier X mau kirim apa besok?" — pertanyaan itu butuh
// mencatat EKSPEKTASI sebelum barangnya benar-benar tiba, dan sebelum
// pengiriman diinspeksi (diterima penuh/sebagian/ditolak).
//
// PRINSIP INTI: dokumen ini TIDAK PERNAH menyimpan angka stok. Ia menyimpan
// STATUS PROSES (draft → dijadwalkan → tiba → inspeksi → siap ditempatkan →
// selesai). Baris StockMovement RECEIPT baru ditulis saat putaway
// dikonfirmasi (POST /goods-receipts/:id/putaway) — disiplin PRD §8.1
// ("stok tidak pernah disimpan, selalu dihitung dari ledger") TIDAK
// dilanggar sedikit pun oleh penambahan ini.
//
// AMAN DILAKUKAN SEKARANG: tabel materials & stock_movements masih KOSONG
// di production — tidak ada goods receipt historis yang perlu direkonstruksi
// dari ledger yang sudah telanjur tertulis satu langkah.
enum ReceiptSourceType {
  PURCHASE_ORDER
  SUPPLIER_DELIVERY
  PRODUCTION_RETURN
  CUSTOMER_RETURN
  INTER_WAREHOUSE_TRANSFER
  MANUAL
}

enum ReceiptStatus {
  DRAFT
  SCHEDULED
  ARRIVED
  INSPECTION
  READY_FOR_PUTAWAY
  COMPLETED
  REJECTED
}

model GoodsReceipt {
  id            String            @id @default(uuid()) @db.Uuid
  receiptNumber String            @unique @map("receipt_number") // GR-DDMMYY-NN
  sourceType    ReceiptSourceType @map("source_type")

  // String bebas, BUKAN FK — tidak ada sistem Purchase Order di v1. Nomor PO/
  // referensi internal dicatat apa adanya, sama seperti `supplier` di ledger.
  sourceReference String? @map("source_reference")
  supplier        String?

  expectedDate DateTime? @map("expected_date") @db.Date
  receivedDate DateTime? @map("received_date") @db.Date
  deliveryNote String?   @map("delivery_note")
  notes        String?

  status ReceiptStatus @default(DRAFT)

  // SetNull: dispatcher/gudang resign, riwayat penerimaan TETAP ada.
  createdById String? @map("created_by")
  createdBy   User?   @relation("GoodsReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines                 GoodsReceiptLine[]
  movements             StockMovement[]
  replenishmentRequests ReplenishmentRequest[]

  @@index([status])
  @@index([expectedDate])
  @@map("goods_receipts")
}

// Baris rencana per material dalam satu goods receipt. TIDAK menyimpan
// saldo — cuma "berapa yang direncanakan/diterima/diterima BAIK/ditolak",
// murni untuk membandingkan ekspektasi vs kenyataan sebelum putaway menulis
// baris ledger yang sebenarnya.
model GoodsReceiptLine {
  id             String       @id @default(uuid()) @db.Uuid
  goodsReceiptId String       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  orderedQty  Float? @map("ordered_qty") // NULL kalau tidak ada PO acuan (mis. retur produksi)
  receivedQty Float? @map("received_qty") // diisi saat status ARRIVED
  acceptedQty Float? @map("accepted_qty") // diisi saat inspeksi — INI yang jadi StockMovement
  rejectedQty Float? @map("rejected_qty")

  condition String? // catatan kondisi fisik saat inspeksi
  notes     String?

  @@index([goodsReceiptId])
  @@index([materialId])
  @@map("goods_receipt_lines")
}

// ─── MATERIAL ISSUE (Warehouse Tahap 3, 2 Agustus 2026) ─────────────────────
//
// KENAPA BARU SEKARANG. v1 inventory cuma punya POST /movements/issue —
// SATU langkah, WAJIB unitId, langsung tercatat ke ledger. Itu masih benar
// dan TIDAK DIUBAH (dipakai jalur "keluarkan material ke unit produksi
// tertentu, sekarang juga"). Tapi Production sekarang minta material lewat
// alur REQUEST → APPROVAL → PICKING → ISSUE, untuk kebutuhan yang belum
// tentu terikat satu Unit (maintenance, sample, kebutuhan line produksi
// umum) dan perlu di-approve dulu sebelum gudang mengeluarkan barang.
//
// INI SATU-SATUNYA TEMPAT "Reserved" JADI NYATA. Reserved BUKAN kolom
// tersimpan — dihitung on-the-fly sebagai SUM(requestedQty) atas baris
// MaterialIssueLine yang induknya berstatus APPROVED/READY_TO_PICK/PICKED
// (lihat RESERVED_STATUSES di routes/goodsReceipt-sibling routes/
// materialIssue.js, dan GET /inventory/stock yang menjumlahkannya). DRAFT
// dan WAITING_APPROVAL BELUM mereservasi apa pun — itu masih permintaan,
// bukan komitmen gudang. Begitu ISSUED, baris StockMovement ISSUE
// ditulis dan reservasinya otomatis lepas (status sudah bukan salah satu
// dari tiga di atas lagi) — tidak ada dua sumber kebenaran yang bisa beda.
//
// AMAN DILAKUKAN SEKARANG: stock_movements masih KOSONG di production,
// tidak ada permintaan historis yang perlu direkonstruksi.
enum IssueSourceType {
  PRODUCTION_WORK_ORDER
  MAINTENANCE_REQUEST
  INTERNAL_REQUEST
  SAMPLE_REQUEST
  MANUAL
}

enum IssueStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  READY_TO_PICK
  PICKED
  ISSUED
  CANCELLED
}

enum IssuePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model MaterialIssue {
  id          String          @id @default(uuid()) @db.Uuid
  issueNumber String          @unique @map("issue_number") // MI-DDMMYY-NN
  sourceType  IssueSourceType @map("source_type")

  // String bebas, BUKAN FK — tidak ada sistem Work Order/Maintenance Ticket
  // terpisah di v1. Sama pola dengan GoodsReceipt.sourceReference.
  sourceReference String? @map("source_reference")
  department      String?

  // SetNull: staf resign, riwayat permintaan TETAP ada. Default pembuat
  // record — kalau warehouse yang input atas nama orang lain, department
  // (teks bebas) yang menjawab "dari mana", bukan field ini.
  requestedById String? @map("requested_by")
  requestedBy   User?   @relation("MaterialIssueRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  requiredDate DateTime?     @map("required_date") @db.Date
  priority     IssuePriority @default(NORMAL)
  notes        String?

  status IssueStatus @default(DRAFT)

  approvedById String?   @map("approved_by")
  approvedBy   User?     @relation("MaterialIssueApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime? @map("approved_at")

  issuedById String?   @map("issued_by")
  issuedBy   User?     @relation("MaterialIssueIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt   DateTime? @map("issued_at")

  createdById String? @map("created_by")
  createdBy   User?   @relation("MaterialIssueCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines     MaterialIssueLine[]
  movements StockMovement[]

  @@index([status])
  @@index([requiredDate])
  @@map("material_issues")
}

model MaterialIssueLine {
  id              String        @id @default(uuid()) @db.Uuid
  materialIssueId String        @map("material_issue_id") @db.Uuid
  materialIssue   MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  requestedQty Float  @map("requested_qty") // INI yang dihitung sebagai Reserved selama APPROVED..PICKED
  issuedQty    Float? @map("issued_qty") // diisi saat status ISSUED — INI yang jadi StockMovement

  // v1: string bebas sama seperti StockMovement.location, BUKAN FK ke
  // tabel lokasi (belum ada — lihat catatan di StockMovement).
  sourceLocation String? @map("source_location")
  notes          String?

  @@index([materialIssueId])
  @@index([materialId])
  @@map("material_issue_lines")
}

// ─── LOKASI PENYIMPANAN (Warehouse Tahap 4, 2 Agustus 2026) ─────────────────
//
// KENAPA BARU SEKARANG. `StockMovement.location` (sejak v1) sengaja string
// bebas berdefault "GUDANG_UTAMA" — cukup selama tidak ada fitur yang benar-
// benar butuh MEMBANDINGKAN dua lokasi (mis. "apakah tujuan sama dengan
// asal?"). Stock Transfer butuh perbandingan itu, jadi string bebas tidak
// lagi cukup — perlu entitas nyata dengan identitas, bukan dua string yang
// kebetulan sama karakternya.
//
// HIERARKI SEDERHANA (Warehouse → Zone → Rack → Bin) disatukan jadi SATU
// tabel StorageLocation dengan kolom zone/rack/bin, BUKAN tiga tabel
// terpisah — YAGNI, tidak ada kebutuhan nyata query "semua Rack di semua
// Zone lintas Warehouse" yang butuh Rack jadi entitas sendiri. `code` adalah
// representasi manusia lengkapnya (mis. "RAW-MATERIAL/RACK-A/BIN-A01"),
// dipakai juga sebagai nilai `StockMovement.location` yang ditulis Transfer
// — supaya riwayat pergerakan tetap terbaca tanpa join ke tabel ini.
//
// ⚠️ SENGAJA TIDAK MENYENTUH GoodsReceiptLine/MaterialIssueLine — keduanya
// masih location string bebas. Menyambungkannya ke StorageLocation adalah
// pembersihan terpisah, bukan bagian Tahap 4 (tidak ada gap fungsional
// yang mendesak di sana, beda dengan Transfer yang sama sekali belum ada).
//
// AMAN DILAKUKAN SEKARANG: stock_movements masih KOSONG di production.
enum LocationType {
  RECEIVING_AREA
  RAW_MATERIAL_AREA
  WIP_AREA
  FINISHED_GOODS_AREA
  QUARANTINE_AREA
  DAMAGED_AREA
  RETURN_AREA
  DISPATCH_AREA
}

model Warehouse {
  id      String  @id @default(uuid()) @db.Uuid
  code    String  @unique // mis. "WH-JKT"
  name    String
  address String?
  active  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  locations StorageLocation[]

  @@map("warehouses")
}

model StorageLocation {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  zone String // mis. "RAW-MATERIAL" — juga label seksi gudang
  rack String?
  bin  String?

  locationType LocationType @map("location_type")
  active       Boolean      @default(true)

  // Representasi manusia lengkap: "<zone>/<rack>/<bin>" (bagian yang NULL
  // dilewati). Dibuat sekali saat lokasi dibuat — dipakai sebagai nilai
  // StockMovement.location string yang sudah ada, supaya movement history
  // tetap terbaca tanpa join.
  code String @unique

  createdAt DateTime @default(now()) @map("created_at")

  transfersFrom       StockTransfer[]      @relation("TransferSource")
  transfersTo         StockTransfer[]      @relation("TransferDestination")
  damagedStockRecords DamagedStockRecord[]

  @@index([warehouseId])
  @@map("storage_locations")
}

// ─── STOCK TRANSFER (Warehouse Tahap 4) ─────────────────────────────────────
//
// DUA BARIS LEDGER PER LINE, DITULIS DI DUA LANGKAH BERBEDA — bukan satu
// langkah seperti Goods Receipt/Material Issue:
//   1. Confirm Dispatch (PICKED → IN_TRANSIT): tulis movement TRANSFER
//      NEGATIF di lokasi asal sebesar qtySent. Barang "meninggalkan" saldo
//      lokasi asal SAAT ITU JUGA — mencerminkan kenyataan fisik (barang di
//      truk, bukan lagi di rak asal).
//   2. Confirm Receipt (IN_TRANSIT → COMPLETED): tulis movement TRANSFER
//      POSITIF di lokasi tujuan sebesar qtyReceived (BISA beda dari
//      qtySent — itulah `difference` yang diminta spesifikasi).
//
// Konsekuensi JUJUR dari desain ini: total saldo material se-gudang
// (SUM(qty) tanpa peduli lokasi — cara GET /inventory/stock menghitung
// hari ini) akan TURUN SEMENTARA selama status IN_TRANSIT, baru kembali
// utuh setelah receipt dikonfirmasi. Itu BUKAN bug — barang yang sedang di
// perjalanan memang tidak bisa dialokasikan ke permintaan mana pun sampai
// benar-benar tiba.
//
// ⚠️ KETERBATASAN YANG DIAKUI: Reserved (Tahap 3) HANYA menghitung dari
// Material Issue yang APPROVED..PICKED — Transfer yang APPROVED/PICKED
// TIDAK ikut mengurangi Available. Secara teori dua permintaan (satu
// Material Issue, satu Stock Transfer) bisa sama-sama "disetujui" atas
// stok yang sama sebelum salah satunya benar-benar dieksekusi. Menyatukan
// keduanya butuh keputusan desain sendiri (satu tabel reservasi generik
// vs union query) — ditunda, bukan diselesaikan tergesa-gesa di sini.
enum TransferType {
  BIN_TO_BIN
  ZONE_TO_ZONE
  WAREHOUSE_TO_WAREHOUSE
  AVAILABLE_TO_QUARANTINE
  QUARANTINE_TO_AVAILABLE
  AVAILABLE_TO_DAMAGED
  RETURN_TO_WAREHOUSE
}

enum TransferStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  PICKED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id             String       @id @default(uuid()) @db.Uuid
  transferNumber String       @unique @map("transfer_number") // TRF-DDMMYY-NN
  transferType   TransferType @map("transfer_type")

  sourceLocationId String          @map("source_location_id") @db.Uuid
  sourceLocation   StorageLocation @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)

  destinationLocationId String          @map("destination_location_id") @db.Uuid
  destinationLocation   StorageLocation @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)

  status TransferStatus @default(DRAFT)

  requestedById String?   @map("requested_by")
  requestedBy   User?     @relation("StockTransferRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?   @map("approved_by")
  approvedBy    User?     @relation("StockTransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime? @map("approved_at")

  dispatchedAt DateTime? @map("dispatched_at")
  receivedAt   DateTime? @map("received_at")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines     StockTransferLine[]
  movements StockMovement[]

  @@index([status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id              String        @id @default(uuid()) @db.Uuid
  stockTransferId String        @map("stock_transfer_id") @db.Uuid
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  qtySent     Float   @map("qty_sent")
  qtyReceived Float?  @map("qty_received") // diisi saat Confirm Receipt — selisih dari qtySent dihitung di UI, tidak disimpan
  notes       String?

  @@index([stockTransferId])
  @@index([materialId])
  @@map("stock_transfer_lines")
}

// ─── STOCK COUNT / STOCK OPNAME (Warehouse Tahap 5) ─────────────────────────
//
// v1 SUDAH punya penyesuaian stok satu langkah: POST /inventory/movements/
// adjustment menerima hasil hitung fisik, menghitung selisih dari saldo
// ledger BERJALAN, dan mencatatnya sebagai satu baris ADJUSTMENT — itu
// TIDAK DIUBAH, masih jalan untuk "hitung satu item, sesuaikan sekarang".
// StockCount adalah DOKUMEN di depannya untuk sesi hitung yang terjadwal,
// mencakup banyak item sekaligus, dan (opsional) BLIND COUNT — staf mengisi
// countedQty TANPA melihat systemQty sampai submit.
//
// systemQty DISNAPSHOT SEKALI, saat Start Count (SCHEDULED → IN_PROGRESS) —
// BUKAN dihitung ulang tiap saat. Itu yang membuat blind count berarti
// (staf membandingkan terhadap DUNIA NYATA saat berjalan ke rak, bukan
// terhadap ledger yang mungkin sudah berubah lagi) dan membuat "difference"
// di layar review konsisten dengan angka yang sama sepanjang sesi.
//
// STOK TIDAK BERUBAH SAMPAI Complete Count — baris ADJUSTMENT baru ditulis
// di langkah itu, satu per baris yang punya selisih. Baris tanpa selisih
// TIDAK menghasilkan movement (tidak ada yang perlu disesuaikan). Disiplin
// PRD §8.1 tetap utuh: stok tidak pernah ditulis sebelum benar-benar final.
//
// ⚠️ CAKUPAN YANG SENGAJA DIPANGKAS:
//   · Difference VALUE (Rupiah) dari spesifikasi TIDAK dihitung — Material
//     tidak punya kolom harga/costing (unitCost hanya tercatat PER
//     PENERIMAAN di StockMovement, bukan atribut material). Menghitung
//     nilai selisih tanpa baseline harga yang benar akan mengarang angka.
//   · "Assigned Team" (jamak) disederhanakan jadi SATU assignedTo — tidak
//     ada entitas tim/grup kerja di sistem ini.
//   · Count Method (By Category/By Location/dst) HANYA label kategorisasi,
//     BUKAN filter otomatis yang mengisi baris — item dipilih manual saat
//     StockCount dibuat, sama pola dengan Goods Receipt/Material Issue.
//   · Evidence (foto) TIDAK ADA upload — butuh storage terpisah, sama
//     alasan dengan Goods Receipt Tahap 2B.
enum CountType {
  CYCLE_COUNT
  FULL_STOCK_OPNAME
}

enum CountMethod {
  BY_ITEM
  BY_CATEGORY
  BY_LOCATION
  BY_BATCH
  RANDOM_SAMPLING
  FULL_WAREHOUSE
}

enum CountStatus {
  SCHEDULED
  IN_PROGRESS
  WAITING_REVIEW
  COMPLETED
  CANCELLED
}

model StockCount {
  id          String      @id @default(uuid()) @db.Uuid
  countNumber String      @unique @map("count_number") // CC-DDMMYY-NN
  countType   CountType   @map("count_type")
  countMethod CountMethod @map("count_method")

  scheduledDate DateTime? @map("scheduled_date") @db.Date
  // Default true — spesifikasi eksplisit: "Staff tidak selalu melihat
  // system quantity" saat hitung berjalan. Bisa dimatikan per sesi kalau
  // memang tidak relevan (mis. hitung ulang setelah selisih diketahui).
  blindCount    Boolean   @default(true) @map("blind_count")
  notes         String?

  status CountStatus @default(SCHEDULED)

  assignedToId String? @map("assigned_to")
  assignedTo   User?   @relation("StockCountAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  startedAt   DateTime? @map("started_at")
  submittedAt DateTime? @map("submitted_at")

  reviewedById String? @map("reviewed_by")
  reviewedBy   User?   @relation("StockCountReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  completedAt DateTime? @map("completed_at")

  createdById String? @map("created_by")
  createdBy   User?   @relation("StockCountCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines     StockCountLine[]
  movements StockMovement[]

  @@index([status])
  @@index([scheduledDate])
  @@map("stock_counts")
}

model StockCountLine {
  id           String     @id @default(uuid()) @db.Uuid
  stockCountId String     @map("stock_count_id") @db.Uuid
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  systemQty  Float? @map("system_qty") // snapshot SEKALI saat Start Count — bukan dihitung ulang
  countedQty Float? @map("counted_qty") // diisi staf saat hitung berjalan

  // WAJIB diisi kalau ada selisih (divalidasi di route, sama pola dengan
  // WASTE/ADJUSTMENT di routes/inventory.js — selisih tanpa penjelasan
  // bukan angka yang bisa dipertanggungjawabkan).
  reason String?
  notes  String?

  @@index([stockCountId])
  @@index([materialId])
  @@map("stock_count_lines")
}

// ─── DAMAGED, RETURN & ADJUSTMENT (Warehouse Tahap 6) ───────────────────────
//
// KETIGANYA MEMAKAI TIPE MOVEMENT YANG SUDAH ADA sejak v1 (WASTE, RETURN,
// ADJUSTMENT) — TIDAK ADA enum StockMovementType baru di tahap ini. Bedanya
// dengan endpoint satu-langkah yang sudah ada (POST /movements/waste,
// /return, /adjustment — TIDAK diubah, tetap jalan untuk koreksi cepat):
// tiga dokumen di bawah membungkus KEPUTUSAN yang perlu ditinjau dulu
// sebelum ledger benar-benar ditulis, sama disiplinnya dengan Goods
// Receipt/Material Issue/Stock Transfer/Stock Count.
//
// ⚠️ KONSEKUENSI YANG DIAKUI (sama keterbatasan dengan Tahap 4): sistem ini
// TIDAK punya saldo "per lokasi/status" — SUM(qty) selalu lintas lokasi.
// Jadi melaporkan barang rusak (DamagedStockRecord) TIDAK otomatis
// mengurangi saldo "tersedia" — barang itu masih terhitung on-hand sampai
// resolusi akhirnya benar-benar mengeluarkannya (Dispose/Return to
// Supplier). Ini BUKAN bug, ini jujur soal apa yang benar-benar diketahui
// sistem: "dilaporkan rusak" dan "sudah dikeluarkan dari stok" adalah DUA
// fakta berbeda, dan cuma yang kedua yang mengubah angka.
//
// ⚠️ TIDAK MENYENTUH reservasi (Reserved, Tahap 3-4). Ketiga dokumen ini
// resolusi atas stok yang SUDAH ADA, bukan permintaan alokasi ke masa
// depan — beda semantik dengan Material Issue/Stock Transfer, jadi tidak
// perlu (dan tidak seharusnya) ikut mengurangi Available.

enum DamageCategory {
  TORN
  WET
  CONTAMINATED
  DEFORMED
  PACKAGING_DAMAGE
  EXPIRED
  PRODUCTION_DEFECT
  DELIVERY_DAMAGE
  OTHER
}

enum DamagedStockStatus {
  REPORTED
  UNDER_INSPECTION
  RESOLVED
}

// Cuma DISPOSE & RETURN_TO_SUPPLIER yang menulis movement (WASTE) — barang
// benar-benar keluar dari sistem. REWORK & RESTORE_TO_AVAILABLE TIDAK
// menulis apa pun: barangnya tidak pernah dianggap keluar dari saldo.
enum DamagedResolution {
  RETURN_TO_SUPPLIER
  REWORK
  DISPOSE
  RESTORE_TO_AVAILABLE
}

model DamagedStockRecord {
  id           String @id @default(uuid()) @db.Uuid
  recordNumber String @unique @map("record_number") // DMG-DDMMYY-NN

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  qty        Float

  damageCategory DamageCategory @map("damage_category")

  // Opsional & informasional — "Move to Damaged Area" tercatat sebagai
  // penanda lokasi, BUKAN transfer ledger otomatis. Kalau barangnya
  // benar-benar perlu dipindah rak, itu Stock Transfer terpisah (Tahap 4).
  locationId String?          @map("location_id") @db.Uuid
  location   StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  status DamagedStockStatus @default(REPORTED)

  reportedById String?  @map("reported_by")
  reportedBy   User?    @relation("DamagedStockReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedAt   DateTime @default(now()) @map("reported_at")

  resolution     DamagedResolution? @map("resolution")
  resolutionNote String?            @map("resolution_note")
  resolvedById   String?            @map("resolved_by")
  resolvedBy     User?              @relation("DamagedStockResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?          @map("resolved_at")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@index([status])
  @@map("damaged_stock_records")
}

enum ReturnType {
  CUSTOMER_RETURN
  DELIVERY_RETURN
  PRODUCTION_RETURN
  SUPPLIER_RETURN
}

enum ReturnRecordStatus {
  CREATED
  RECEIVED
  INSPECTION
  COMPLETED
  CANCELLED
}

// Cuma RETURN_TO_AVAILABLE yang menulis movement (RETURN, positif — barang
// benar-benar masuk stok terpakai). Lima resolusi lain TIDAK: QUARANTINE/
// REWORK barang tidak dianggap keluar (masih ditinjau), RETURN_TO_SUPPLIER/
// DISPOSE barang TIDAK PERNAH dianggap masuk stok (ditolak langsung, sama
// prinsipnya dengan rejectedQty di Goods Receipt), REPLACE_PRODUCT
// penggantinya jalan lewat Goods Receipt/Material Issue terpisah.
enum ReturnResolution {
  RETURN_TO_AVAILABLE
  QUARANTINE
  REWORK
  RETURN_TO_SUPPLIER
  DISPOSE
  REPLACE_PRODUCT
}

model ReturnRecord {
  id           String     @id @default(uuid()) @db.Uuid
  returnNumber String     @unique @map("return_number") // RTN-DDMMYY-NN
  returnType   ReturnType @map("return_type")

  // String bebas — sama pola dengan GoodsReceipt.sourceReference. Bisa
  // menunjuk Order/Delivery Job/PO, tapi lintas modul yang formatnya
  // beda-beda, bukan FK tunggal yang jujur.
  reference String?

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  qty        Float
  condition  String? // catatan kondisi fisik barang retur

  status ReturnRecordStatus @default(CREATED)

  inspectionNote String?           @map("inspection_note")
  resolution     ReturnResolution?

  createdById String? @map("created_by")
  createdBy   User?   @relation("ReturnRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)

  receivedAt  DateTime? @map("received_at")
  inspectedAt DateTime? @map("inspected_at")
  completedAt DateTime? @map("completed_at")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@index([status])
  @@map("return_records")
}

enum AdjustmentRequestType {
  POSITIVE
  NEGATIVE
  COUNT_DIFFERENCE
  DAMAGE
  EXPIRY
  DATA_CORRECTION
  CONVERSION
  OTHER
}

enum AdjustmentRequestStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  POSTED
  CANCELLED
}

// Beda dengan POST /inventory/movements/adjustment (satu langkah, langsung
// tertulis — dipakai Stock Count Tahap 5 & koreksi cepat Gudang.jsx): ini
// WAJIB approval sebelum ledger tersentuh. Spesifikasi minta "high-value
// adjustment perlu approval" — Material tidak punya kolom harga (lihat
// catatan Tahap 5), jadi TIDAK bisa jujur membedakan "tinggi" vs "rendah"
// nilainya. Keputusannya: SEMUA request lewat dokumen ini wajib approval,
// tanpa kecuali — lebih aman daripada ambang nilai yang diam-diam salah.
model StockAdjustmentRequest {
  id               String                @id @default(uuid()) @db.Uuid
  adjustmentNumber String                @unique @map("adjustment_number") // ADJ-DDMMYY-NN
  adjustmentType   AdjustmentRequestType @map("adjustment_type")

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  beforeQty     Float @map("before_qty") // snapshot saldo ledger SAAT REQUEST DIBUAT
  adjustmentQty Float @map("adjustment_qty") // delta (+/-); afterQty = beforeQty + adjustmentQty, dihitung di UI

  reason String // WAJIB — tidak ada default, form menolak kosong

  status AdjustmentRequestStatus @default(DRAFT)

  requestedById String?   @map("requested_by")
  requestedBy   User?     @relation("StockAdjustmentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?   @map("approved_by")
  approvedBy    User?     @relation("StockAdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime? @map("approved_at")
  postedById    String?   @map("posted_by")
  postedBy      User?     @relation("StockAdjustmentPoster", fields: [postedById], references: [id], onDelete: SetNull)
  postedAt      DateTime? @map("posted_at")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@index([status])
  @@map("stock_adjustment_requests")
}

// ─── REPLENISHMENT (Warehouse Tahap 7) ──────────────────────────────────────
//
// KENAPA GRATIS SEKARANG. Material.reorderPoint & reorderQty sudah ada
// SEJAK v1 (PRD FR-I-05) tapi belum pernah benar-benar dipakai jadi
// saran — cuma alarm senyap. Tahap ini mengubahnya jadi permintaan yang
// bisa ditinjau: reorderPoint = pemicu ("kapan"), reorderQty = jawaban
// spesifikasi "Suggested Quantity" ("berapa"). TIDAK ADA "Maximum Stock"
// yang dikarang — field itu tidak pernah ada di Material, dan
// reorderQty SUDAH menjawab pertanyaan yang sama secara jujur.
//
// SARAN (suggestion) TIDAK PERNAH DISIMPAN sebagai baris — dihitung
// on-the-fly (GET /replenishment/suggestions: available ≤ reorderPoint),
// sama disiplin dengan saldo stok itu sendiri. Baru jadi baris NYATA
// (ReplenishmentRequest) begitu seseorang mengklik "Create Request".
//
// TIDAK PERNAH MENULIS stock_movements SENDIRI — barang yang benar-benar
// tiba dicatat lewat Goods Receipt (Tahap 2B) seperti biasa. Selesainya
// sebuah replenishment adalah MENAUTKAN ke GoodsReceipt yang sudah ada
// (goodsReceiptId, diisi manual — sama pola dengan UnitRevision.jobId di
// modul Delivery), BUKAN menduplikasi pencatatan penerimaan.
//
// "In Progress" dari spesifikasi DILEBUR ke ORDERED — replenishment yang
// sudah dipesan MEMANG "berjalan" sampai barangnya tiba; status terpisah
// untuk itu tidak menambah informasi apa pun yang ORDERED belum punya.
enum ReplenishmentSource {
  MINIMUM_STOCK_RULE
  REORDER_POINT
  PRODUCTION_FORECAST
  SALES_DEMAND
  MANUAL_REQUEST
  LOCATION_REFILL
}

enum ReplenishmentStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  ORDERED
  COMPLETED
  REJECTED
}

model ReplenishmentRequest {
  id            String              @id @default(uuid()) @db.Uuid
  requestNumber String              @unique @map("request_number") // RP-DDMMYY-NN
  source        ReplenishmentSource

  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  // Snapshot SAAT REQUEST DIBUAT — sama pola dengan
  // StockAdjustmentRequest.beforeQty. Material.reorderPoint bisa diubah
  // gudang kapan pun; angka di request TETAP mencerminkan kondisi saat
  // permintaan diajukan, bukan diam-diam ikut berubah.
  currentStockSnapshot Float  @map("current_stock_snapshot")
  minimumStockSnapshot Float? @map("minimum_stock_snapshot")

  // Default dari Material.reorderQty saat dibuat — BOLEH diedit (spesifikasi:
  // "Review quantity" adalah langkah eksplisit sebelum approval).
  suggestedQty Float @map("suggested_qty")

  requiredDate DateTime?     @map("required_date") @db.Date
  // Reuse IssuePriority (Tahap 3) — bentuknya identik (LOW/NORMAL/HIGH/
  // URGENT), tidak ada alasan mendefinisikan enum kembar.
  priority     IssuePriority @default(NORMAL)
  // String bebas — sama pola dengan GoodsReceipt.supplier. Tidak ada
  // entitas Supplier terpisah di sistem ini.
  supplier     String?

  status ReplenishmentStatus @default(DRAFT)

  requestedById  String?   @map("requested_by")
  requestedBy    User?     @relation("ReplenishmentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById   String?   @map("approved_by")
  approvedBy     User?     @relation("ReplenishmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime? @map("approved_at")
  orderedAt      DateTime? @map("ordered_at")
  rejectedReason String?   @map("rejected_reason")

  // Penanda "sudah benar-benar tiba" — menaut ke GoodsReceipt yang
  // menciptakan movement RECEIPT-nya. SetNull: GoodsReceipt boleh
  // dihapus/diubah tanpa menghapus riwayat permintaan ini.
  goodsReceiptId String?       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([materialId])
  @@map("replenishment_requests")
}
