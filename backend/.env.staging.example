# STAGING (P12A) — salin ke backend/.env.staging (TIDAK di-commit). Jangan memakai nilai dari production.
# Tidak ada kredensial eksternal di sini DISENGAJA: WhatsApp (WAHA), email, webhook otomasi, push, Maps, AI, Instagram dibiarkan kosong.
APP_ENV=staging
JWT_SECRET=ganti-dengan-string-acak-panjang-khusus-staging
STAGING_DB_PASSWORD=ganti-dengan-password-db-staging
STAGING_PORT=18080
