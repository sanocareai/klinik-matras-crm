# Database
DATABASE_URL="postgresql://klinik:klinik123@localhost:5432/klinik_matras"

# Auth
JWT_SECRET="ganti-dengan-string-random-yang-panjang-dan-rahasia"

# WAHA (WhatsApp HTTP API)
WAHA_BASE_URL="http://localhost:3000"
WAHA_API_KEY=""
WAHA_SESSION="default"

# Server
PORT=4000

# Tracking Link — nomor WA tujuan default kalau link tidak punya targetPhone
WAHA_BUSINESS_NUMBER="6281234567890"

# Google Maps Platform (Distance Matrix, Geocoding, Directions) — Sano Hub dispatch/ETA
# WAJIB restrict key ini ke IP VPS backend di Google Cloud Console
GOOGLE_MAPS_API_KEY=""

# MCP server READ-ONLY (/mcp) — akses BACA data CRM untuk Claude.ai
# KOSONG = fitur MATI total (endpoint /mcp menjawab 503). Isi untuk mengaktifkan.
# Bukan JWT user: ini token mesin-ke-mesin, dipasang sekali di sisi Claude.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotasi/cabut akses = ganti nilai di sini lalu restart backend.
MCP_API_TOKEN=""
# Batas request per menit per IP (default 60 kalau tidak diisi).
MCP_RATE_LIMIT_PER_MIN=60

# OAuth 2.1 untuk /mcp dari claude.ai BROWSER (pelengkap MCP_API_TOKEN di
# atas, bukan pengganti — Claude Code/Desktop tetap pakai token statis).
# Diperlukan karena UI custom connector claude.ai cuma punya field OAuth,
# tidak ada input header kustom. Hanya user ber-role ADMIN yang bisa login.
# MCP_PUBLIC_URL = origin publik server ini (tanpa trailing slash), dipakai
# di URL metadata OAuth. Dev: http://localhost:4000. Production: domain asli.
MCP_PUBLIC_URL="http://localhost:4000"
# Secret buat menandatangani access token OAuth MCP — WAJIB BEDA dari
# JWT_SECRET (login CRM), supaya dua jenis token tidak bisa dipakai silang.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_OAUTH_JWT_SECRET=""

# SANO Hub Analytics MCP (/mcp-hub) — connector KEDUA di Claude, paralel
# dengan SANSS CRM (bukan pengganti). Expose data quality scorer/risk
# engine/stale lead/gold standard — READ-ONLY di level DATABASE (bukan
# cuma tidak ada tool tulis). Lihat docs/MCP-HUB-SERVER.md untuk setup
# role Postgres read-only-nya.
MCP_HUB_API_TOKEN=""
MCP_HUB_RATE_LIMIT_PER_MIN=60
# Connection string KHUSUS role Postgres read-only (mcp_hub_readonly) —
# WAJIB BEDA dari DATABASE_URL utama. Format sama, user/password beda.
MCP_HUB_READONLY_DATABASE_URL=""
