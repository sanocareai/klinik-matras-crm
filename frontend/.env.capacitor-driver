# Build APK Driver (Capacitor project terpisah, lihat ../driver-app) —
# absolute URL ke server produksi, sama seperti .env.capacitor (APK sales).
# Dipakai saat: npm run build:capacitor:driver
VITE_API_BASE=https://app.sanomatrassehat.com

# VITE_APP_TARGET=driver — dibaca Layout.jsx untuk memangkas chrome (workspace
# switcher, bel notifikasi) KHUSUS di build ini, TIDAK di PWA/web biasa
# (yang tidak set variabel ini sama sekali, jadi perilakunya tetap seperti
# semula). Lihat catatan panjang di Layout.jsx untuk kenapa ini build-time,
# bukan deteksi runtime Capacitor.getPlatform() — appId/platform 'android'
# tidak membedakan APK sales vs APK driver, keduanya sama-sama Capacitor
# Android biasa dari sudut pandang API itu.
VITE_APP_TARGET=driver
