node_modules/
.env
# frontend/dist/ — TIDAK di-ignore, agar VPS bisa git pull langsung tanpa perlu npm run build di VPS
*.log
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/unit-photos/*
!backend/data/unit-photos/.gitkeep
backend/data/job-photos/*
!backend/data/job-photos/.gitkeep
backend/data/payment-proofs/*
!backend/data/payment-proofs/.gitkeep
backend/data/knowledge/documents/*
!backend/data/knowledge/documents/.gitkeep
backend/data/knowledge/meta.json
backend/data/driver-app-bundles/*
!backend/data/driver-app-bundles/.gitkeep

# Capacitor Android — keystore JANGAN di-commit (simpan terpisah di tempat aman)
frontend/android/release.keystore

# APK Driver — project Capacitor TERPISAH (../driver-app), lihat catatan
# panjang di frontend/vite.config.driver.js. dist-driver murni artefak lokal
# untuk build APK (BUKAN dipakai VPS sama sekali, beda dari frontend/dist/
# di atas) — diignore, bukan dikomit. Keystore-nya sama alasan dengan
# frontend/android/release.keystore.
frontend/dist-driver/
driver-app/android/release.keystore

backups/
