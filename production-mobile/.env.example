# Salin ke .env (tidak di-commit) untuk `expo start` lokal. Di EAS nilai ini datang dari eas.json.
# Semua EXPO_PUBLIC_* ikut TERBUNDEL ke aplikasi — JANGAN taruh rahasia di sini.
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
# Emulator Android: 10.0.2.2 = localhost komputer. HP fisik: pakai IP LAN komputer.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
EAS_PROJECT_ID=
EAS_OWNER=sanocare
